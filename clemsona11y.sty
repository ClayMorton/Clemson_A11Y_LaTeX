% clemsona11y.sty -- accessible (tagged, PDF/UA-2) LaTeX in one package.
% Clemson University, CCIT Internal Operations, ADA Compliance Team (A11Y).
% Class-independent; tested with article, report, book and ClemsonThesis.
% Requires LuaLaTeX and LaTeX 2026-06-01+; the guards below enforce both.
%
% Recipe:
%   1. Above \documentclass (a package is read too late to set these):
%        \DocumentMetadata{lang=en-US, pdfversion=2.0, pdfstandard=ua-2,
%          pdfstandard=a-4f, tagging=on, check-tagging-status}
%   2. \usepackage{clemsona11y} as the LAST preamble line; it loads hyperref,
%      which asks to come after everything else. Give hyperref, amsmath, float
%      or graphicx your own options with \PassOptionsToPackage before it.
%   3. \includegraphics[alt={...}] on every informative image ([artifact] on a
%      decorative one) and \tagpdfsetup{table/header-rows={1}} inside each
%      table environment. Build with LuaLaTeX, check with verapdf -f ua2.
%
% Options -- \usepackage[key=value]{clemsona11y}; * = default. An unknown
% value stops the build, because a mistyped option is otherwise silent.
%   fonts      termes* | lm | false   text+math font via fontspec/unicode-math
%   floats     here*   | free         [H] as the default float placement
%   headings   word*   | kernel       title=H1, chapter=H2 ... or kernel Title
%   title      h1*     | none         tag the kernel \maketitle title as H1
%   links      keep*   | hidden       black underlined links, or hidelinks
%   pagination plain*  | typed        untyped artifact, or /Type /Pagination
%   math       af*     | full         MathML attached as a file, or also as
%                                     structure elements (PDF/UA-2 readers)
%
% Details: README.md; LaTeX_A11Y.md, Standards checklist.
% Meets: ISO 14289-2:2024 (PDF/UA-2); ISO 32000-2:2020 14.8 (tagged PDF).
\newcommand{\clemsonaDate}{2026/09/21}
\newcommand{\clemsonaVersion}{1.0}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{clemsona11y}[\clemsonaDate\space v\clemsonaVersion\space
  Accessible (tagged, PDF/UA-2) LaTeX in one package -- Clemson University A11Y]



% A11Y: TOOLCHAIN GUARDS
% Four checks that refuse to build when the toolchain cannot tag; each failure
% otherwise yields a normal-looking untagged PDF that goes unnoticed until an
% ADA review. (1) LuaLaTeX: only it runs luamml for MathML and OpenType fonts
% with a ToUnicode map, so pdfLaTeX and XeLaTeX are rejected.
% Meets: ISO 32000-2:2020 14.8.1 (MarkInfo /Marked true).
\RequirePackage{iftex}
\ifLuaTeX\else
    \PackageError{clemsona11y}%
        {This document must be compiled with LuaLaTeX}%
        {An accessible (tagged) PDF requires the LuaLaTeX engine.^^J%
         Command line: run 'latexmk -lualatex yourfile.tex' (or 'make', if the
         project has a Makefile).^^J%
         Overleaf: Menu > Settings > Compiler > LuaLaTeX.^^J%
         TeXShop / TeXworks / VS Code: choose the LuaLaTeX typesetting engine.^^J%
         Tip: the two "magic comment" lines '!TEX program = lualatex' and^^J%
         '!TEX TS-program = lualatex' (each one written after a percent sign)^^J%
         on the first two lines of your .tex file make most editors do it for
         you.}
\fi
\RequireLuaTeX

% (2) Format floor, never a pin: 2026-06-01 is the first release that tags [H]
% floats in place. Newer releases are expected to work and to improve on it.
\IfFormatAtLeastTF{2026-06-01}{}{%
    \PackageError{clemsona11y}%
        {Your LaTeX is too old to make an accessible (tagged) PDF}%
        {This package needs the LaTeX release of 2026-06-01 or newer.^^J%
         Install TeX Live 2026 / MacTeX 2026 (https://tug.org/texlive/),^^J%
         or update what you have: run 'tlmgr update --self --all'.^^J%
         Overleaf: Menu > Settings > TeX Live version > 2026 (and Compiler >
         LuaLaTeX).}%
}

% (3) \DocumentMetadata must precede \documentclass, or tagging is off.
\NeedsDocumentMetadata

% (4) Tagging must still be active when the body starts: \tag_if_active:TF is
% the kernel's own test, so ask it once at \begin{document}.
\newcommand{\clemsonaTaggingError}{%
    \PackageError{clemsona11y}%
        {PDF tagging is not active -- this PDF would NOT be accessible}%
        {Tagging must be switched on for this document.^^J%
         Check that the first thing in your .tex file is the
         \string\DocumentMetadata block^^J%
         and that it contains 'tagging = on'.^^J%
         Do not put \string\tagpdfsetup{activate=off} or \string\SuspendTagging
         in the preamble.}%
}
\ExplSyntaxOn
\AtBeginDocument
  {
    \cs_if_exist:NTF \tag_if_active:TF
      { \tag_if_active:TF { } { \clemsonaTaggingError } }
      { \clemsonaTaggingError }
  }
\ExplSyntaxOff


% Options: store each value here, act on it in the block that owns it. Acting
% at once would let a default load a font package before fonts=false arrived.
% \clemsona@if{\stored}{wanted}{then}{else} is the \ifx test those blocks use.
\newcommand*{\clemsona@fonts}{termes}
\newcommand*{\clemsona@floats}{here}
\newcommand*{\clemsona@headings}{word}
\newcommand*{\clemsona@title}{h1}
\newcommand*{\clemsona@links}{keep}
\newcommand*{\clemsona@pagination}{plain}
\newcommand*{\clemsona@math}{af}
\newcommand*{\clemsona@tmp}{}
\newcommand{\clemsona@if}[4]{%
    \def\clemsona@tmp{#2}\ifx#1\clemsona@tmp#3\else#4\fi}
\DeclareKeys[clemsona11y]{
  fonts    .store = \clemsona@fonts,
  fonts    .usage = load,
  floats   .store = \clemsona@floats,
  floats   .usage = load,
  headings .store = \clemsona@headings,
  headings .usage = load,
  title    .store = \clemsona@title,
  title    .usage = load,
  links    .store = \clemsona@links,
  links    .usage = load,
  pagination .store = \clemsona@pagination,
  pagination .usage = load,
  math       .store = \clemsona@math,
  math       .usage = load,
}
\ProcessKeyOptions[clemsona11y]

% Option validation: \clemsona@check walks the legal list with the same \ifx
% the blocks below use and errors naming the values. Without it a typo such as
% headings=Word is accepted in silence and the setting it controls never
% happens. Adding a value: extend this list, the table above and its block.
\newif\ifclemsona@known
\newcommand*{\clemsona@check}[2]{%
    \clemsona@knownfalse
    \expandafter\let\expandafter\clemsona@value\csname clemsona@#1\endcsname
    \@for\clemsona@tmp:=#2\do{%
        \ifx\clemsona@value\clemsona@tmp \clemsona@knowntrue\fi}%
    \ifclemsona@known\else
        \PackageError{clemsona11y}%
            {Unknown value '\clemsona@value' for option '#1' --
             use one of: #2}%
            {The option #1 of package clemsona11y accepts only these values:^^J%
             #1 = #2.^^J%
             You wrote \string\usepackage[#1=\clemsona@value]{clemsona11y}.^^J%
             Values are lower case and spelled exactly as in the option table
             at the top of clemsona11y.sty, which also says what each one
             does.^^J%
             Correct the spelling -- or delete the option to use the default --
             and compile again.}%
    \fi}
\clemsona@check{fonts}{termes,lm,false}
\clemsona@check{floats}{here,free}
\clemsona@check{headings}{word,kernel}
\clemsona@check{title}{h1,none}
\clemsona@check{links}{hidden,keep}
\clemsona@check{pagination}{plain,typed}
\clemsona@check{math}{af,full}


% A11Y: FONTS
% fontspec and unicode-math give every glyph a ToUnicode entry, so the text is
% searchable, copyable and pronounceable, and luamml gets the glyph data it
% needs to write correct MathML. termes is metric-compatible with Times New
% Roman. amsmath is named first so \PassOptionsToPackage can still reach it.
% Meets: ISO 32000-2:2020 14.8.2.6.1; ISO 14289-2:2024 8.4.5.8 (ToUnicode).
\RequirePackage{amsmath}
\clemsona@if{\clemsona@fonts}{false}{%
    \PackageWarningNoLine{clemsona11y}{%
        Option fonts=false: no font package is loaded.^^J%
        Load fontspec and unicode-math yourself, or the MathML written for
        your^^J%
        equations may contain the wrong characters and the PDF may fail
        veraPDF^^J%
        check 8.4.5.8 (fonts must map every character code to Unicode)}%
}{%
    % Do not add amssymb or bm on top of unicode-math: amssymb aborts on
    % symbols unicode-math already defines, bm silently prints non-bold maths.
    % Use \symbf for bold maths.
    \RequirePackage{fontspec}%    OpenType text fonts + Unicode text encoding
    \RequirePackage{unicode-math}% OpenType maths fonts; what luamml needs
    \clemsona@if{\clemsona@fonts}{lm}{%
        % fontspec already defaults the text font to Latin Modern Roman.
        \setmathfont{Latin Modern Math}%
    }{%
        % Times-like default, as the Graduate School format requires.
        \setmainfont{TeX Gyre Termes}%      body + headings: Times New Roman clone
        \setmathfont{TeX Gyre Termes Math}% matching maths, full Unicode coverage
    }%
    % A11Y: \strong
    % Map fontspec's \strong to a Strong element through the kernel's inline
    % tagging socket. \textbf is only a font switch and leaves no trace in the
    % tag tree, so bold used as meaning is lost on a screen reader. Keep
    % \textbf in table header cells, which are announced as headers already.
    % Meets: ISO 32000-2:2020 14.8.4.7.2 Table 368 (Strong).
    \AddToHook{cmd/strong/before}{\leavevmode\UseTaggingSocket{inline/begin}{tag=Strong}}%
    \AddToHook{cmd/strong/after}{\UseTaggingSocket{inline/end}}%
}


% A11Y: GRAPHICS
% Load graphicx so \includegraphics and its alt= and [artifact] keys exist:
% step 3 of the recipe promises that interface, and a document that loads
% nothing else stops with "Undefined control sequence" without it. Loading it
% twice is harmless; pass your own options with \PassOptionsToPackage first.
% Meets: ISO 32000-2:2020 14.8.4.8.5 (Figure Alt); Tagged PDF BPG 1.0.1 5.5.2.
\RequirePackage{graphicx}


% A11Y: FAIL-SAFE ROLE MAPPING. \AssignStructureRole stores the tag under the
% kernel's structure name; a name that a future release renames would take the
% assignment in silence and the mapping would just stop. \clemsona@role checks
% that the name exists first and otherwise warns, so `make check` fails loudly.
% Meets: the maintenance rule of this package (no silent loss of a mapping).
\ExplSyntaxOn
\cs_new_protected:Npn \clemsona@role #1 #2
  {
    \tl_if_exist:cTF { l__tag_name_#1_tl }
      { \AssignStructureRole {#1} {#2} }
      {
        \PackageWarningNoLine{clemsona11y}{%
            Structure~name~'#1'~is~unknown~to~this~LaTeX~release:~the^^J%
            mapping~to~'#2'~was~skipped.~Check~the~tag~tree~and~this~package}
      }
  }
\ExplSyntaxOff

% A11Y: FLOATS
% Tag every float where it stands in the source. With tagging on the kernel
% otherwise defers floats into figures/tables bins at the end of the tree, so
% a screen reader meets every table after the bibliography. floats=here also
% prints them there ([H]); float/here fixes the tags for floats=free too.
% Meets: ISO 32000-2:2020 14.8.2.5.1 (page order = logical content order).
\RequirePackage{float}
\clemsona@if{\clemsona@floats}{here}{%
    \floatplacement{figure}{H}%  a plain \begin{figure} means \begin{figure}[H]
    \floatplacement{table}{H}%   a plain \begin{table}  means \begin{table}[H]
}{}
\tagpdfsetup{float/here}%        tags go where the float is written, not at the end
% DO NOT "FIX" THE Aside TAG: float containers are named Aside, the PDF 2.0
% tag the kernel maps them to anyway. Acrobat is a PDF 1.7 tool and shows
% Aside as "Note". Do not remap to Div: Div is transparent, so the Caption is
% judged against the enclosing Sect and fails the first/last-child rule.
% Meets: ISO 32000-2:2020 14.8.4.4 Table 365; ISO 14289-2:2024 8.2.5.27.
\clemsona@role{float/figure}{Aside}
\clemsona@role{float/table}{Aside}
% A11Y WORKAROUND: \par ends the paragraph the float interrupts, then
% paragraph tagging goes off for the float body, so Figure/Table is a direct
% child of the Aside instead of sitting inside an empty P.
% REMOVE WHEN: the tagging project offers that nesting with paragraph tagging
% left on -- https://github.com/latex3/tagging-project/issues
% Meets: Tagged PDF BPG 1.0.1 4.3.1 (Figure and Caption under the container).
\AddToHook{env/figure/begin}{\par\tagpdfsetup{para/tagging=false}}
% Price of the line above -- RULE 1: inside a float use only \centering,
% \includegraphics, tabular, \caption, \label, \tagpdfsetup; center, quote,
% lists and \[ \] abort with "text para hooks differ". RULE 2: blank line
% before \begin{figure}/\begin{table}. Loose text in a float becomes an
% artifact: put a source note in the \caption or in a paragraph after it.
% Meets: ISO 32000-2:2020 14.8.2.2.2 (artifact marking).
\AddToHook{env/table/begin}{\par\tagpdfsetup{para/tagging=false}}


% A11Y: TAG THE CAPTION NUMBER
% "Figure 1.1" is tagged Span, not Lbl. Acrobat's PDF/UA-1 rule "Lbl and
% LBody" flags every Lbl outside a list item, so the default Lbl reports every
% caption in the document. Both tags are valid; PDF/UA-2 requires neither.
% Restore with \AssignStructureRole{float/figure/label}{Lbl} in your preamble.
% Meets: Tagged PDF BPG 1.0.1 4.2.4 (caption label); 4.2.7 (Span).
\clemsona@role{float/figure/label}{Span}  % "Figure 1.1" -> Span, not Lbl
\clemsona@role{float/table/label}{Span}   % "Table 2.3"  -> Span, not Lbl
% The same rule hits the section number in a contents entry, the raised mark
% in the text and the number before a footnote's text; all become Span. The
% mark and the note stay paired by their two-way Ref, which PDF/UA-2 requires;
% the BPG's optional Lbl-matching is given up so Acrobat stays clean.
% Meets: ISO 14289-2:2024 8.2.5.14 (note Ref pair); BPG 4.2.8 (Lbl optional).
\clemsona@role{toc/item/label}{Span}      % "2.1" in the contents -> Span
\clemsona@role{fnote/mark}{Span}          % the raised mark in the text
\clemsona@role{fnote/note/label}{Span}    % "1" before a footnote -> Span


% A11Y: MATHEMATICS. Every formula is a Formula with Alt text and its MathML
% attached as a file (math=af): one content item per formula, a clean tree in
% Acrobat and PAC. math=full also writes MathML structure elements (the PDF
% Association's Math BPG direction) at the price of empty spacing tags and one
% reading-order item per symbol in PDF/UA-1 tools. Both pass veraPDF PDF/UA-2.
% Meets: ISO 32000-2:2020 14.8.6.3 (MathML); PDF Association BPG Math in PDF 1.0.
\clemsona@if{\clemsona@math}{full}{%
    \tagpdfsetup{math/setup={mathml-SE,mathml-AF}}%
}{%
    \tagpdfsetup{math/setup={mathml-AF}}%
}
\tagpdfsetup{math/alt/use}% Alt on every Formula; its text is set just below

% A11Y WORKAROUND: FORMULA ALT TEXT. latex-lab-math's Alt is an internal
% template ("LaTeX formula starts ... ends") with no user interface yet
% (latex-lab-math.pdf 5.7; tagging-project discussion 717). This math/content
% plug uses the text of \mathalt{...} written right before a formula, else the
% bare LaTeX source. REMOVE WHEN: the kernel offers a formula alt-text key.
% Meets: ISO 14289-2:2024 8.2.5.29; ISO 14289-1:2014 7.7 (Alt on Formula).
\ExplSyntaxOn
\tl_new:N \g__cly_mathalt_tl
\NewDocumentCommand \mathalt { m } { \tl_gset:Nn \g__cly_mathalt_tl {#1} }
% A \mathalt with no formula after it would otherwise still be waiting when the
% next formula is tagged, anywhere later in the document, and give that formula
% the wrong alt text. The paragraph the text was written in is the end of its
% reach. Meets: ISO 14289-2:2024 8.2.5.29 (Alt describes its own content).
\AddToHook { para/after } { \tl_gclear:N \g__cly_mathalt_tl }
\tl_if_exist:NF \l__math_content_template_tl
  {
    \PackageWarningNoLine{clemsona11y}{%
        latex-lab-math~internals~not~found:~\string\mathalt~text~is~ignored~and^^J%
        every~formula~keeps~the~kernel's~default~alt~text}
  }
\tl_if_exist:NT \l__math_content_template_tl
  {
    \tl_set:Nn \l__math_content_template_tl { \exp_not:V \g__math_grabbed_math_tl }
    \NewTaggingSocketPlug {math/content} {clemsonally}
      {
        \tl_if_empty:NTF \g__cly_mathalt_tl
          { \tl_set:Ne \l__math_content_alt_tl { \l__math_content_template_tl } }
          {
            \tl_set:Ne \l__math_content_alt_tl
              { \text_purify:V \g__cly_mathalt_tl }
            \tl_gclear:N \g__cly_mathalt_tl
          }
        \tl_set:Ne \l__math_content_AF_source_tl { \l__math_texsource_template_tl }
        \tl_set:Nn \l__math_content_AF_mathml_tl {}
        \tl_set:Nn \l__math_content_actual_tl {}
      }
    \AssignTaggingSocketPlug {math/content} {clemsonally}
  }
\ExplSyntaxOff


% A11Y: THE HEADING MAP
% headings=word moves every sectioning level down one rung so the document
% title is the only H1: chapter H2, section H3, subsection H4, subsubsection
% H5, paragraph H6, one rung less in article. That is the Graduate School's
% Word ladder, and a screen reader needs a ladder with no missing rungs.
% Meets: ISO 32000-2:2020 14.8.4.5 Table 366; Tagged PDF BPG 1.0.1 4.2.2.
\clemsona@if{\clemsona@headings}{word}{%
    \ifdefined\chapter
        % book, report, ClemsonThesis: level 0 is \chapter.
        \clemsona@role{sec/0/title}{H2}% \chapter, \chapter* -> "Heading 2"
        \clemsona@role{sec/1/title}{H3}% \section            -> "Heading 3"
        \clemsona@role{sec/2/title}{H4}% \subsection         -> "Heading 4"
        \clemsona@role{sec/3/title}{H5}% \subsubsection      -> "Heading 5"
        \clemsona@role{sec/4/title}{H6}% \paragraph -- rarely used, but set
    \else
        % article: no \chapter, so \section is the top heading. \part is left
        % alone; a document that uses one decides its own top heading.
        \clemsona@role{sec/1/title}{H2}% \section            -> "Heading 2"
        \clemsona@role{sec/2/title}{H3}% \subsection         -> "Heading 3"
        \clemsona@role{sec/3/title}{H4}% \subsubsection      -> "Heading 4"
        \clemsona@role{sec/4/title}{H5}% \paragraph -- rarely used, but set
    \fi
}{}
% THE ALTERNATIVE, IF A REVIEWER EVER INSISTS ON THE PDF 2.0 Title TAG:
% headings=kernel. Title plug (title=h1 with headings=word): the socket plug
% below makes the title printed by the kernel's \maketitle an H1. A class with
% its own title page passes title=none and tags the title line itself with
% \AssignStructureRole{para/textblock}{H1}.
% Meets: ISO 32000-2:2020 14.8.4.5 Table 366; BPG 1.0.1 Annex B A.3.2.1.
\def\clemsona@tmp{h1}
\ifx\clemsona@title\clemsona@tmp
    \def\clemsona@tmp{word}
    \ifx\clemsona@headings\clemsona@tmp
        \NewTaggingSocketPlug{title}{h1}{\clemsona@role{para/textblock}{H1}#2}
        \AssignTaggingSocketPlug{title}{h1}
    \fi
\fi


% A11Y: LINKS AND THE BOOKMARK PANEL
% hyperref is loaded last in this file, as its own manual asks, through
% \PassOptionsToPackage so a class's hyperref options survive. The bookmark
% panel is how a screen-reader user navigates a long document, so it reaches
% subsections (bookmarksdepth=3) even when the printed ToC stops earlier.
% Meets: Tagged PDF BPG 1.0.1 7.2 (outlines); 3.3 (title displayed, not file).
\PassOptionsToPackage{%
    bookmarksnumbered,%       outline reads "1 Introduction"
    bookmarksopen,%           chapters already expanded
    bookmarksdepth=3,%        outline goes down to \subsubsection
    pdfdisplaydoctitle=true,% window title = document title, not thesis.pdf
    linktoc=all%              contents entries: title AND page number are links
  }{hyperref}
% links=hidden adds hidelinks: no color, no border, no underline (a class or
% journal that forbids link styling). Either value leaves a tagged Link.
\clemsona@if{\clemsona@links}{hidden}{%
    \PassOptionsToPackage{hidelinks,pdfborder={0 0 0}}{hyperref}%
}{}
\RequirePackage{hyperref}
% A11Y: LINK APPEARANCE (links=keep). Text stays one color (black, contrast
% 21:1). A link in running text, a caption or a reference entry gets an
% underline the viewer draws from the annotation's border style, so nothing is
% marked by color alone; the contents and the lists of figures and tables
% stay plain (every line there is a link, so an underline would say nothing).
% Meets: Clemson links concept ("underline links"); WCAG 2.1 1.4.1, 1.4.3.
\clemsona@if{\clemsona@links}{keep}{%
    \hypersetup{colorlinks=true, allcolors=black, allbordercolors=black,
                pdfborderstyle={/S/U/W 1}}%
    % The link box is the line's box, so its bottom edge, where the viewer
    % draws the underline, can touch the glyphs; LuaTeX's link margin pads it.
    \pdfvariable linkmargin=1.5pt%
    \AddToHook{cmd/tableofcontents/before}{\hypersetup{pdfborderstyle={}}}%
    \AddToHook{cmd/tableofcontents/after}{\hypersetup{pdfborderstyle={/S/U/W 1}}}%
    \AddToHook{cmd/listoffigures/before}{\hypersetup{pdfborderstyle={}}}%
    \AddToHook{cmd/listoffigures/after}{\hypersetup{pdfborderstyle={/S/U/W 1}}}%
    \AddToHook{cmd/listoftables/before}{\hypersetup{pdfborderstyle={}}}%
    \AddToHook{cmd/listoftables/after}{\hypersetup{pdfborderstyle={/S/U/W 1}}}%
}{}
% A11Y WORKAROUND: FOOTNOTE MARK LINK BOX. hyperref's fnmark/link plug wraps
% the whole mark box, so the link box is the line's and the underline lands
% under the baseline, far from the raised number. This plug runs hyperref's
% plug inside the raised box (kernel-style marks) or in its own box, so the
% underline sits under the numeral. Calls the plug by its ltsockets csname.
% REMOVE WHEN: latex-lab-footnotes sizes the link to the mark. Meets: WCAG 2.4.4.
\ExplSyntaxOn
\NewSocketPlug{fnmark/link}{clemsonally}
  {
    \str_set:Ne \l_tmpa_str { \cs_meaning:N \@makefnmark }
    \str_if_in:NnTF \l_tmpa_str { @textsuperscript }
      { \hbox{\@textsuperscript{\normalfont \use:c{__socket_fnmark/link_plug_link:w}{\@thefnmark}}} }
      { \hbox{ \use:c{__socket_fnmark/link_plug_link:w}{#1} } }
  }
\ExplSyntaxOff
\clemsona@if{\clemsona@links}{keep}{%
    \AddToHook{begindocument/end}{%
        \ifcsname __socket_fnmark/link_plug_link:w\endcsname
            \AssignSocketPlug{fnmark/link}{clemsonally}%
        \else
            \PackageWarningNoLine{clemsona11y}{%
                hyperref's footnote link plug was not found: footnote marks^^J%
                keep the line-height link box (underline below the line)}%
        \fi}%
}{}

% A11Y WORKAROUND: FOOTNOTE NoteType. latex-lab opens the FENote with no
% attribute, so every note takes the Table 384 default None and nothing in the
% file tells a footnote from any other kind of note. This plug runs the
% kernel's FENote plug, then writes /NoteType /Footnote on the structure it
% just opened. REMOVE WHEN: latex-lab sets NoteType itself.
% Meets: ISO 14289-2:2024 8.2.5.14 (NoteType); ISO 32000-2:2020 Table 384.
\ExplSyntaxOn
\IfSocketPlugExistsTF {tagsupport/fntext/begin} {FENote}
  {
    \NewTaggingSocketPlug {fntext/begin} {clemsonally}
      {
        \use:c { __socket_tagsupport/fntext/begin_plug_FENote:w }
        \tag_struct_gput:ene { \tag_get:n {struct_num} } {attribute}
          { /O~/FENote~/NoteType~/Footnote }
      }
    \AssignTaggingSocketPlug {fntext/begin} {clemsonally}
  }
  {
    \PackageWarningNoLine{clemsona11y}{%
        latex-lab's FENote plug was not found: footnotes carry no^^J%
        NoteType attribute and fall back to the default None}
  }
\ExplSyntaxOff

% A11Y: LINK TEXT. \autoref{label} links the whole phrase ("Section 3",
% "Figure 1", "Appendix A"), which is what a screen reader announces, where
% \ref links the bare number. hyperref's names are set here in title case;
% shared theorem counters need \hyperref[label]{Lemma~\ref*{label}} instead.
% Meets: Clemson links concept (descriptive link text); WCAG 2.1 2.4.4.
\AtBeginDocument{%
    \def\sectionautorefname{Section}\def\subsectionautorefname{Section}%
    \def\subsubsectionautorefname{Section}\def\chapterautorefname{Chapter}%
    \def\figureautorefname{Figure}\def\tableautorefname{Table}%
    \def\equationautorefname{Equation}\def\appendixautorefname{Appendix}%
    \providecommand{\algorithmautorefname}{Algorithm}%
    \def\footnoteautorefname{footnote}\def\itemautorefname{item}%
}

% A11Y: LINK ANNOTATION /Contents
% Give every link annotation a generic type description through the documented
% l3pdfannot interface. PDF/UA-1 requires an annotation to carry one and the
% Acrobat and PAC checkers apply that rule; PDF/UA-2 dropped it. A screen
% reader reads the link text from the Link element; these are a fallback.
% Meets: ISO 14289-1:2014 7.18.5; Tagged PDF BPG 1.0.1 4.2.12.2.
\ExplSyntaxOn
\pdfannot_dict_put:nnn {link/GoTo}  {Contents} {(Internal~link)}
\pdfannot_dict_put:nnn {link/URI}   {Contents} {(Web~link)}
\pdfannot_dict_put:nnn {link/GoToR} {Contents} {(Link~to~another~file)}
\pdfannot_dict_put:nnn {link/Named} {Contents} {(Link)}
\ExplSyntaxOff


% A11Y WORKAROUND: TABLE CELL ATTRIBUTES AND HEADER IDS. latex-lab-table
% writes Scope, ColSpan and RowSpan only as attribute classes (/C) and no
% /Headers, so Acrobat's Table Editor and PAC show no cell properties. At the
% end of each tabular this block writes them again as direct /A attributes and
% adds /Headers with the /ID of every header cell above or left of a cell.
% Meets: ISO 32000-2:2020 14.8.4.8.3 (Headers, Scope, spans); Clemson tables.
\ExplSyntaxOn
% Reads testphase internals (\g__tbl_struct_cells_seq, \g__tbl_untagged_
% cells_prop, \g__tbl_table_cols_tl, the C entry of g__tag_struct_<n>_prop,
% \__tag_struct_get_id:n, the csname of the Table plug); \socket_set_plug:nnn
% and \tag_struct_gput:nnn are documented. longtable is not covered. If an
% internal is gone the guard logs one line and the block does nothing.
% REMOVE WHEN: latex-lab-table writes Headers and direct attributes itself.
\bool_new:N \l__hdrs_ok_bool
\bool_set:Nn \l__hdrs_ok_bool
  {
    \seq_if_exist_p:N \g__tbl_struct_cells_seq &&
    \prop_if_exist_p:N \g__tbl_untagged_cells_prop &&
    \tl_if_exist_p:N \g__tbl_table_cols_tl &&
    \tl_if_exist_p:N \g__tbl_struct_table_tl &&
    \cs_if_exist_p:N \__tag_struct_get_id:n &&
    \cs_if_exist_p:N \tag_struct_gput:nnn &&
    \cs_if_exist_p:c { __socket_tagsupport/tbl/finalize_plug_Table:w }
  }
\bool_if:NF \l__hdrs_ok_bool
  {
    \PackageWarningNoLine{clemsona11y}{%
        latex-lab-table~internals~not~found:~no~/Headers~and~no~direct~cell^^J%
        attributes~are~written.~The~PDF~still~passes~veraPDF,~so~check~the^^J%
        cell~properties~in~Acrobat's~Table~Editor~before~shipping~it}
  }
\bool_if:NT \l__hdrs_ok_bool
{

% State for one table. The grid maps "row,col" to a cell structure number, so a
% cell that spans appears once per slot it covers. minr/maxr/minc/maxc give the
% anchor and the spans; scope holds Column, Row or Both for header cells only.
% order keeps the cells in the sequence they were tagged in.
\prop_new:N  \l__hdrs_grid_prop
\prop_new:N  \l__hdrs_minr_prop
\prop_new:N  \l__hdrs_maxr_prop
\prop_new:N  \l__hdrs_minc_prop
\prop_new:N  \l__hdrs_maxc_prop
\prop_new:N  \l__hdrs_scope_prop
\prop_new:N  \l__hdrs_untagged_prop
\seq_new:N   \l__hdrs_order_seq
\seq_new:N   \l__hdrs_cells_seq
\clist_new:N \l__hdrs_row_clist
\clist_new:N \l__hdrs_list_clist
\clist_new:N \l__hdrs_block_clist
\tl_new:N    \l__hdrs_table_tl
\tl_new:N    \l__hdrs_cell_tl
\tl_new:N    \l__hdrs_test_tl
\tl_new:N    \l__hdrs_scope_tl
\tl_new:N    \l__hdrs_dict_tl
\str_new:N   \l__hdrs_class_str
\int_new:N   \l__hdrs_rows_int
\int_new:N   \l__hdrs_cols_int
\int_new:N   \l__hdrs_idx_int
\int_new:N   \l__hdrs_r_int
\int_new:N   \l__hdrs_c_int
\int_new:N   \l__hdrs_anchor_row_int
\int_new:N   \l__hdrs_anchor_col_int
\bool_new:N  \l__hdrs_go_bool
\bool_new:N  \l__hdrs_hit_bool
\bool_new:N  \l__hdrs_pres_bool

\cs_generate_variant:Nn \prop_item:Nn  { Ne }
\cs_generate_variant:Nn \prop_put:Nnn  { Nee }

% Grid and scope lookups, expandable so they can be used inside \tl_set:Ne.
\cs_new:Npn \__hdrs_at:nn #1 #2
  { \prop_item:Ne \l__hdrs_grid_prop { #1,#2 } }
\cs_new:Npn \__hdrs_scope:n #1
  { \prop_item:Ne \l__hdrs_scope_prop { #1 } }

% Store one grid slot. The first slot a cell occupies fixes its anchor row and
% column; later slots widen the span. Cells are numbered by structure number,
% so the same number arriving again is the same cell, not a new one.
\cs_new_protected:Npn \__hdrs_record:nnn #1 #2 #3 % row, column, structure number
  {
    \prop_put:Nee \l__hdrs_grid_prop { #1,#2 } { #3 }
    \prop_if_in:NnTF \l__hdrs_minr_prop { #3 }
      {
        \prop_put:Nee \l__hdrs_maxr_prop { #3 }
          { \int_max:nn { \prop_item:Nn \l__hdrs_maxr_prop { #3 } } { #1 } }
        \prop_put:Nee \l__hdrs_maxc_prop { #3 }
          { \int_max:nn { \prop_item:Nn \l__hdrs_maxc_prop { #3 } } { #2 } }
        \prop_put:Nee \l__hdrs_minc_prop { #3 }
          { \int_min:nn { \prop_item:Nn \l__hdrs_minc_prop { #3 } } { #2 } }
      }
      {
        \prop_put:Nee \l__hdrs_minr_prop { #3 } { #1 }
        \prop_put:Nee \l__hdrs_maxr_prop { #3 } { #1 }
        \prop_put:Nee \l__hdrs_minc_prop { #3 } { #2 }
        \prop_put:Nee \l__hdrs_maxc_prop { #3 } { #2 }
        \seq_put_right:Nn \l__hdrs_order_seq { #3 }
      }
  }
\cs_generate_variant:Nn \__hdrs_record:nnn { nne }

% One grid slot per column. A slot listed in the untagged property is covered by
% a cell that started in an earlier row (table/multirow), so it repeats the cell
% above and consumes nothing from the row list. Every other slot takes the next
% entry from the row list; a negative entry is a column a colspan covers.
\cs_new_protected:Npn \__hdrs_cell:nn #1 #2 % row, column
  {
    \prop_if_in:NnTF \l__hdrs_untagged_prop { #1,#2 }
      {
        \tl_set:Ne \l__hdrs_cell_tl
          { \__hdrs_at:nn { \int_eval:n { #1 - 1 } } { #2 } }
      }
      {
        \int_incr:N \l__hdrs_idx_int
        \tl_set:Ne \l__hdrs_cell_tl
          { \clist_item:Nn \l__hdrs_row_clist { \l__hdrs_idx_int } }
        \tl_if_empty:NF \l__hdrs_cell_tl
          { \tl_set:Ne \l__hdrs_cell_tl { \int_abs:n { \l__hdrs_cell_tl } } }
      }
    \tl_if_empty:NF \l__hdrs_cell_tl
      { \__hdrs_record:nne { #1 } { #2 } { \l__hdrs_cell_tl } }
  }

\cs_new_protected:Npn \__hdrs_row:n #1 % row
  {
    \clist_set:Ne \l__hdrs_row_clist { \seq_item:Nn \l__hdrs_cells_seq { #1 } }
    \int_zero:N \l__hdrs_idx_int
    \int_step_inline:nn { \l__hdrs_cols_int } { \__hdrs_cell:nn { #1 } { ##1 } }
  }

% Header cells are recognized by the attribute classes latex-lab-table gave
% them: TH-col heads a column, TH-row heads a row, TH-both heads both. Reading
% the classes rather than the header-row and header-column lists keeps this
% package on the same decision the table code already made.
\cs_new_protected:Npn \__hdrs_read_scopes:
  {
    \seq_map_inline:Nn \l__hdrs_order_seq
      {
        \prop_if_exist:cT { g__tag_struct_ ##1 _prop }
          {
            \prop_get:cnNT { g__tag_struct_ ##1 _prop } { C } \l__hdrs_test_tl
              {
                \str_set:Ne \l__hdrs_class_str { \l__hdrs_test_tl }
                \str_if_in:NnTF \l__hdrs_class_str { /TH-both }
                  { \prop_put:Nnn \l__hdrs_scope_prop { ##1 } { Both } }
                  {
                    \str_if_in:NnTF \l__hdrs_class_str { /TH-col }
                      { \prop_put:Nnn \l__hdrs_scope_prop { ##1 } { Column } }
                      {
                        \str_if_in:NnT \l__hdrs_class_str { /TH-row }
                          { \prop_put:Nnn \l__hdrs_scope_prop { ##1 } { Row } }
                      }
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \__hdrs_build_grid:
  {
    \prop_clear:N \l__hdrs_grid_prop
    \prop_clear:N \l__hdrs_minr_prop
    \prop_clear:N \l__hdrs_maxr_prop
    \prop_clear:N \l__hdrs_minc_prop
    \prop_clear:N \l__hdrs_maxc_prop
    \prop_clear:N \l__hdrs_scope_prop
    \seq_clear:N  \l__hdrs_order_seq
    \int_step_inline:nn { \l__hdrs_rows_int } { \__hdrs_row:n { ##1 } }
    \__hdrs_read_scopes:
  }

% True when the slot holds a header cell of the wanted scope and is not the cell
% being worked on. Both counts for either direction, which is what the corner
% cell of a table with a header row and a header column carries.
\cs_new_protected:Npn \__hdrs_test_head:nnnn #1 #2 #3 #4 % row, col, self, scope
  {
    \bool_set_false:N \l__hdrs_hit_bool
    \tl_set:Ne \l__hdrs_test_tl { \__hdrs_at:nn { #1 } { #2 } }
    \tl_if_empty:NF \l__hdrs_test_tl
      {
        \str_if_eq:eeF { \l__hdrs_test_tl } { #3 }
          {
            \tl_set:Ne \l__hdrs_scope_tl { \__hdrs_scope:n { \l__hdrs_test_tl } }
            \bool_lazy_or:nnT
              { \str_if_eq_p:ee { \l__hdrs_scope_tl } { #4 } }
              { \str_if_eq_p:ee { \l__hdrs_scope_tl } { Both } }
              { \bool_set_true:N \l__hdrs_hit_bool }
          }
      }
  }

% Header cells above a cell, column by column. Two blocks are kept: the block of
% header rows at the top of the table, and the nearest block of header rows just
% above the cell. A table with group headers in the middle then gives a data
% cell its column heading and its own group heading, not every group heading.
\cs_new_protected:Npn \__hdrs_collect_col:nn #1 #2 % structure number, column
  {
    \int_set:Nn \l__hdrs_r_int { 1 }
    \bool_set_true:N \l__hdrs_go_bool
    \bool_while_do:nn
      { \l__hdrs_go_bool && \int_compare_p:n { \l__hdrs_r_int < \l__hdrs_anchor_row_int } }
      {
        \__hdrs_test_head:nnnn { \int_use:N \l__hdrs_r_int } { #2 } { #1 } { Column }
        \bool_if:NTF \l__hdrs_hit_bool
          {
            \clist_put_right:NV \l__hdrs_list_clist \l__hdrs_test_tl
            \int_incr:N \l__hdrs_r_int
          }
          { \bool_set_false:N \l__hdrs_go_bool }
      }
    \clist_clear:N \l__hdrs_block_clist
    \int_set:Nn \l__hdrs_r_int { \l__hdrs_anchor_row_int - 1 }
    \bool_set_true:N \l__hdrs_go_bool
    \bool_while_do:nn
      { \l__hdrs_go_bool && \int_compare_p:n { \l__hdrs_r_int > 0 } }
      {
        \__hdrs_test_head:nnnn { \int_use:N \l__hdrs_r_int } { #2 } { #1 } { Column }
        \bool_if:NTF \l__hdrs_hit_bool
          {
            \clist_put_left:NV \l__hdrs_block_clist \l__hdrs_test_tl
            \int_decr:N \l__hdrs_r_int
          }
          { \bool_set_false:N \l__hdrs_go_bool }
      }
    \clist_concat:NNN \l__hdrs_list_clist \l__hdrs_list_clist \l__hdrs_block_clist
  }

% Header cells left of a cell, row by row: the block of header columns at the
% left edge and the nearest block of header columns before the cell.
\cs_new_protected:Npn \__hdrs_collect_row:nn #1 #2 % structure number, row
  {
    \int_set:Nn \l__hdrs_c_int { 1 }
    \bool_set_true:N \l__hdrs_go_bool
    \bool_while_do:nn
      { \l__hdrs_go_bool && \int_compare_p:n { \l__hdrs_c_int < \l__hdrs_anchor_col_int } }
      {
        \__hdrs_test_head:nnnn { #2 } { \int_use:N \l__hdrs_c_int } { #1 } { Row }
        \bool_if:NTF \l__hdrs_hit_bool
          {
            \clist_put_right:NV \l__hdrs_list_clist \l__hdrs_test_tl
            \int_incr:N \l__hdrs_c_int
          }
          { \bool_set_false:N \l__hdrs_go_bool }
      }
    \clist_clear:N \l__hdrs_block_clist
    \int_set:Nn \l__hdrs_c_int { \l__hdrs_anchor_col_int - 1 }
    \bool_set_true:N \l__hdrs_go_bool
    \bool_while_do:nn
      { \l__hdrs_go_bool && \int_compare_p:n { \l__hdrs_c_int > 0 } }
      {
        \__hdrs_test_head:nnnn { #2 } { \int_use:N \l__hdrs_c_int } { #1 } { Row }
        \bool_if:NTF \l__hdrs_hit_bool
          {
            \clist_put_left:NV \l__hdrs_block_clist \l__hdrs_test_tl
            \int_decr:N \l__hdrs_c_int
          }
          { \bool_set_false:N \l__hdrs_go_bool }
      }
    \clist_concat:NNN \l__hdrs_list_clist \l__hdrs_list_clist \l__hdrs_block_clist
  }

% One cell: build its attribute dictionary and hand it to tagpdf. Column headers
% come first, then row headers, both in reading order. \tag_struct_gput:nnn with
% the documented attribute key writes the dictionary as its own object and
% appends it to /A, so the existing /C classes are left untouched.
\cs_new_protected:Npn \__hdrs_do_cell:n #1 % structure number
  {
    \tl_clear:N \l__hdrs_dict_tl
    \int_set:Nn \l__hdrs_anchor_row_int { \prop_item:Nn \l__hdrs_minr_prop { #1 } }
    \int_set:Nn \l__hdrs_anchor_col_int { \prop_item:Nn \l__hdrs_minc_prop { #1 } }
    \tl_set:Ne \l__hdrs_scope_tl { \__hdrs_scope:n { #1 } }
    \tl_if_empty:NF \l__hdrs_scope_tl
      { \tl_put_right:Ne \l__hdrs_dict_tl { ~/Scope~/ \l__hdrs_scope_tl } }
    \int_compare:nNnT
      { \prop_item:Nn \l__hdrs_maxc_prop { #1 } } > { \l__hdrs_anchor_col_int }
      {
        \tl_put_right:Ne \l__hdrs_dict_tl
          { ~/ColSpan~
            \int_eval:n
              { \prop_item:Nn \l__hdrs_maxc_prop { #1 } - \l__hdrs_anchor_col_int + 1 } }
      }
    \int_compare:nNnT
      { \prop_item:Nn \l__hdrs_maxr_prop { #1 } } > { \l__hdrs_anchor_row_int }
      {
        \tl_put_right:Ne \l__hdrs_dict_tl
          { ~/RowSpan~
            \int_eval:n
              { \prop_item:Nn \l__hdrs_maxr_prop { #1 } - \l__hdrs_anchor_row_int + 1 } }
      }
    \clist_clear:N \l__hdrs_list_clist
    \int_step_inline:nnn
      { \l__hdrs_anchor_col_int } { \prop_item:Nn \l__hdrs_maxc_prop { #1 } }
      { \__hdrs_collect_col:nn { #1 } { ##1 } }
    \int_step_inline:nnn
      { \l__hdrs_anchor_row_int } { \prop_item:Nn \l__hdrs_maxr_prop { #1 } }
      { \__hdrs_collect_row:nn { #1 } { ##1 } }
    \clist_remove_duplicates:N \l__hdrs_list_clist
    \clist_if_empty:NF \l__hdrs_list_clist
      {
        \tl_put_right:Nn \l__hdrs_dict_tl { ~/Headers~[ }
        \clist_map_inline:Nn \l__hdrs_list_clist
          {
            \tl_put_right:Ne \l__hdrs_dict_tl
              { \__tag_struct_get_id:n { ##1 } ~ }
          }
        \tl_put_right:Nn \l__hdrs_dict_tl { ] }
      }
    \tl_if_empty:NF \l__hdrs_dict_tl
      { \tag_struct_gput:nne { #1 } { attribute } { /O~/Table \l__hdrs_dict_tl } }
  }

% The finalize plug of a table is the last point at which the row and cell
% structure numbers still exist: the original body restores the enclosing
% table's data and throws them away. So copy them first, run the original body
% (it turns header rows into TH and sets their classes), then read the copies.
\cs_new_protected:Npn \__hdrs_save:
  {
    \seq_set_eq:NN \l__hdrs_cells_seq \g__tbl_struct_cells_seq
    \prop_set_eq:NN \l__hdrs_untagged_prop \g__tbl_untagged_cells_prop
    \int_set:Nn \l__hdrs_rows_int { \seq_count:N \l__hdrs_cells_seq }
    \int_set:Nn \l__hdrs_cols_int { \g__tbl_table_cols_tl }
    \tl_set_eq:NN \l__hdrs_table_tl \g__tbl_struct_table_tl
  }
% A table marked role=presentation carries no cell semantics, so Scope and
% Headers on its cells would contradict the role: leave it alone. A stray
% table/tagging=presentation outside a group reaches every later table.
% Meets: ISO 32000-2:2020 14.8.4.8.3 (Headers); WAI-ARIA 1.1 role=presentation.
\cs_new_protected:Npn \__hdrs_set_presentation:
  {
    \bool_set_false:N \l__hdrs_pres_bool
    \prop_get:cnNT { g__tag_struct_ \l__hdrs_table_tl _prop } { C }
      \l__hdrs_test_tl
      {
        \str_set:Ne \l__hdrs_class_str { \l__hdrs_test_tl }
        \str_if_in:NnT \l__hdrs_class_str { /ARIA-role-presentation }
          { \bool_set_true:N \l__hdrs_pres_bool }
      }
  }
\cs_new_protected:Npn \__hdrs_apply:
  {
    \__hdrs_set_presentation:
    \bool_if:NF \l__hdrs_pres_bool
      {
        \bool_lazy_and:nnT
          { \int_compare_p:n { \l__hdrs_rows_int > 0 } }
          { \int_compare_p:n { \l__hdrs_cols_int > 0 } }
          {
            \__hdrs_build_grid:
            \seq_map_inline:Nn \l__hdrs_order_seq { \__hdrs_do_cell:n { ##1 } }
          }
      }
  }

% The socket plug keeps its name, Table, because \tagpdfsetup{table/tagging=...}
% re-assigns that name and would otherwise drop a plug of any other name. The
% original body is saved first and called in the middle, so nothing the table
% code does is lost. \socket_set_plug:nnn is the documented way to replace it;
% the csname of the saved body is an ltsockets internal.
\cs_new_eq:Nc \__hdrs_orig_finalize:
  { __socket_tagsupport/tbl/finalize_plug_Table:w }
\socket_set_plug:nnn { tagsupport/tbl/finalize } { Table }
  {
    \__hdrs_save:
    \__hdrs_orig_finalize:
    \__hdrs_apply:
  }

}
\ExplSyntaxOff


% A11Y: PAGE FURNITURE
% The kernel wraps header and footer material in /Artifact BMC already, so no
% page number reaches the reading order. pagination=typed writes /Artifact
% <</Type /Pagination>> BDC instead for PDF/UA-1 checkers, at the cost of two
% empty Artifact elements per page ("Private" in Acrobat); plain is default.
% Meets: ISO 14289-1:2014 7.8; Tagged PDF BPG 1.0.1 3.7.2.
\clemsona@if{\clemsona@pagination}{typed}{%
    \tagpdfsetup{page/exclude-header-footer=pagination}%
}{}
% page/exclude-header-footer is tagpdf's own documented key (manual 3.2.6),
% marked experimental; do not patch tagpdf internals for the same effect.

\endinput
