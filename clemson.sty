%------------------------------------------------------------------------------
% FOOTNOTES
%------------------------------------------------------------------------------
% LaTeX tags a footnote as FENote with a Ref both ways and links the mark to
% the note, which is what PDF/UA-2 8.2.5.14 asks for. The package adds the
% optional NoteType Footnote (WTPDF 1.0; 8.2.5.14 only limits its value, and
% a missing one reads as None) in the fntext hook, where the FENote is the
% open structure; the check skips a note that has no FENote (tagging
% suspended). REMOVE WHEN: LaTeX writes NoteType itself (tagging issue 728).
% Meets: ISO 14289-2:2024 8.2.5.14 (FENote and Ref from LaTeX; NoteType value).
\ExplSyntaxOn
\AddToHook { fntext }
  {
    \str_if_eq:eeT { \tag_get:n { struct_tag } } { \UseStructureName { fnote/note } }
      {
        \tag_struct_gput:ene { \tag_get:n { struct_num } } { attribute }
          { /O~/FENote~/NoteType~/Footnote }
      }
  }
\ExplSyntaxOff
% Notes at 9 pt: Clemson's text page says "Avoid small font sizes (less than
% 9 points)"; no ISO or WCAG clause sets a size, so the rule is Clemson's.
% \footnotesize becomes \small everywhere: footnotes, \thanks, the endnote
% list and any \footnotesize text or table (10 and 10.95 pt with 11pt, 12pt).
\renewcommand{\footnotesize}{\small}
%------------------------------------------------------------------------------
% LINKS
%------------------------------------------------------------------------------
% hyperref comes after the packages above, as its manual asks. It makes every
% \ref, \cite, \href, \url and contents entry a link; LaTeX tags each one as
% Link (inside Reference for citations and contents entries) with a structure
% destination and /Tabs /S: ISO 14289-2:2024 8.2.5.20, 8.8, 8.9.3.3. No
% viewer box: UNDERLINES underlines the links that leave the document, as
% Clemson's Links page requires; links inside the document read as text.
% Meets: Clemson Digital Accessibility, Links; WCAG 2.1 SC 1.4.1 (G182).
\RequirePackage{hyperref}
\hypersetup{pdfborder={0 0 0}}
% \strong in a section title stops the build ("Use of \bookmark doesn't
% match its definition"): hyperref's \pdfstringdef handles \emph and \textbf
% but not fontspec's \strong. REMOVE WHEN: hyperref handles \strong.
\pdfstringdefDisableCommands{\let\strong\@firstofone}

%------------------------------------------------------------------------------
% UNDERLINES
%------------------------------------------------------------------------------
% Links that leave the document (\href, \url, \email) are underlined by
% lua-ul, with the rule its \underLine draws by default, in the text itself:
% under the descenders, across line breaks, at the size of the current font,
% in every viewer and in print. Links inside the document (\ref, \autoref,
% \cite, contents entries, note marks) read as text. The switch runs in
% hyperref's own hooks around \href and \url.
% Meets: Clemson Digital Accessibility, Links; WCAG 2.1 SC 1.4.1 (G182).
\RequirePackage{lua-ul}
\newunderlinetype\clemson@underline{\leaders\vrule height -.65ex depth .75ex}
% lua-ul stores each underline rule at its first use at a given size and
% copies it, tagging attributes included, at every later use, so each rule
% was tagged as content of the paragraph that first used that size. Defined
% inside an artifact, every copy is an artifact, as LaTeX's own table and
% footnote rules are. REMOVE WHEN: lua-ul or LaTeX marks these rules as
% artifacts (lua-ul issue 420, tagging issue 1581). Meets: ISO 14289-2 8.2.2.
\ExplSyntaxOn
\cs_new_protected:Npn \clemson@ulon
  { \tag_mc_end_push: \tag_mc_begin:n { artifact }
    \clemson@underline \tag_mc_end: \tag_mc_begin_pop:n { } }
\ExplSyntaxOff
\AddToHook{cmd/href/before}{\begingroup\clemson@ulon}
\AddToHook{cmd/href/after}{\endgroup}
\AddToHook{cmd/url/before}{\begingroup\clemson@ulon}
\AddToHook{cmd/url/after}{\endgroup}
% \email{addr} is a mailto link whose visible text is the address, so a
% screen reader reads the address (Clemson Links page: use the address as
% the link text); \detokenize keeps an underscore in the address from
% being read as math. Meets: WCAG 2.1 SC 2.4.4 (link purpose).
\providecommand{\email}[1]{\href{mailto:#1}{\detokenize{#1}}}
% The contents and the two lists print starred headings that get no outline
% entry, so a reader navigating by bookmarks cannot get to them. hyperref's
% \pdfbookmark adds one before each, at chapter level when the class has
% chapters (a level-1 entry would nest under the previous chapter). With
% chapters the heading starts a new page after this hook runs, so the page
% is turned first, or the bookmark would point at the page before its
% heading. The hooks have the label clemson/bookmark, so a class that
% bookmarks these lists itself can remove them with \RemoveFromHook.
% Meets: Tagged PDF BPG 1.0.1 7.2 (outlines follow the headings).
\newcommand*{\clemson@turnpage}{\if@openright\cleardoublepage\else\clearpage\fi}
\newcommand*{\clemson@bookmark}[2]{\ifdefined\chapter\clemson@turnpage\pdfbookmark[0]{#1}{#2}\else\pdfbookmark[1]{#1}{#2}\fi}
\AddToHook{cmd/tableofcontents/before}[./bookmark]{\clemson@bookmark{\contentsname}{clemson.toc}}
\AddToHook{cmd/listoffigures/before}[./bookmark]{\clemson@bookmark{\listfigurename}{clemson.lof}}
\AddToHook{cmd/listoftables/before}[./bookmark]{\clemson@bookmark{\listtablename}{clemson.lot}}
% The bibliography prints a starred heading with no contents entry and no
% bookmark. A starred heading sets its own link target, so a contents line
% written right after it points at the heading; the hook adds that line
% (section in article, chapter with \chapter) and hyperref makes the bookmark
% from it. The document needs no \addcontentsline before \bibliography.
% Meets: ISO 14289-2:2024 8.2.5.8; Tagged PDF BPG 1.0.1 4.1.4, 7.2.
\newif\ifclemson@bib
\AddToHook{env/thebibliography/before}[./bookmark]{\clemson@bibtrue}
\AddToHook{cmd/section/after}[./bookmark]{\ifclemson@bib\clemson@bibfalse
  \addcontentsline{toc}{section}{\ifdefined\refname\refname\else\bibname\fi}\fi}
\AddToHook{cmd/chapter/after}[./bookmark]{\ifclemson@bib\clemson@bibfalse
  \addcontentsline{toc}{chapter}{\bibname}\fi}
\endinput
