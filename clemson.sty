%------------------------------------------------------------------------------
% FOOTNOTES
%------------------------------------------------------------------------------
% LaTeX tags a footnote as FENote with the Ref pair and links the mark to
% the note. The package adds NoteType Footnote in the fntext hook, skipping
% a note with no FENote. REMOVE WHEN: LaTeX writes NoteType (tagging issue
% 728).
% Meets: ISO 14289-2:2024 8.2.5.14.
\ExplSyntaxOn
\AddToHook { fntext }
  {
    \str_if_eq:eeT { \tag_get:n { struct_tag } } { \UseStructureName { fnote/note } }
      {
        \tag_struct_gput:ene { \tag_get:n { struct_num } } { attribute }
          { /O~/FENote~/NoteType~/Footnote }
      }
  }
\ExplSyntaxOff
% No type under 9pt, so \footnotesize is set to \small.
% Meets: Clemson Digital Accessibility
\renewcommand{\footnotesize}{\small}

%------------------------------------------------------------------------------
% LINKS
%------------------------------------------------------------------------------
% LaTeX tags every link
% Meets: ISO 14289-2:2024 8.2.5.20, 8.8, 8.9.3.3; Clemson Links page.
\RequirePackage{hyperref}
\hypersetup{pdfborder={0 0 0}}
% \strong in a section title stops the build: hyperref's \pdfstringdef knows
% \emph and \textbf, not fontspec's \strong. REMOVE WHEN: hyperref handles it.
\pdfstringdefDisableCommands{\let\strong\@firstofone}

%------------------------------------------------------------------------------
% UNDERLINES
%------------------------------------------------------------------------------
% Every link is underlined by lua-ul in the text itself, except contents entries
% and note marks (superscripts).
% Meets: Clemson Digital Accessibility, Links; WCAG 2.1 SC 1.4.1 (G182).
\RequirePackage{lua-ul}
\newunderlinetype\clemson@underline{\leaders\vrule height -.65ex depth .75ex}
% lua-ul copies each underline rule from its first use, tagging attributes
% included; defined inside an artifact, every copy is an artifact.
% REMOVE WHEN: lua-ul or LaTeX marks the rules as artifacts (lua-ul issue
% 420, tagging issue 1581). Meets: ISO 14289-2:2024 8.2.2.
\ExplSyntaxOn
\cs_new_protected:Npn \clemson@ulon
  { \tag_mc_end_push: \tag_mc_begin:n { artifact }
    \clemson@underline \tag_mc_end: \tag_mc_begin_pop:n { } }
\ExplSyntaxOff
\AddToHook{cmd/href/before}{\begingroup\clemson@ulon}
\AddToHook{cmd/href/after}{\endgroup}
\AddToHook{cmd/url/before}{\begingroup\clemson@ulon}
\AddToHook{cmd/url/after}{\endgroup}
% hyperref runs hyp/link/<type> at every GoTo link but declares only
% hyp/link/cite, so hyp/link/link is used.
% REMOVE WHEN: hyperref declares hyp/link/link (the \ActivateGenericHook line).
\newif\ifclemson@incontents
\ExplSyntaxOn
\str_new:N \l__clemson_dest_str
\cs_new_protected:Npn \clemson@ulink
  {
    \ifclemson@incontents \else
      \str_set:Ne \l__clemson_dest_str { \l_hyp_current_dest_name_tl }
      \str_if_in:NnF \l__clemson_dest_str { footnote }
        { \str_if_in:NnF \l__clemson_dest_str { enz. } { \clemson@ulon } }
    \fi
  }
\ExplSyntaxOff
\ActivateGenericHook{hyp/link/link}
\AddToHook{hyp/link/link}{\clemson@ulink}
\AddToHook{hyp/link/cite}{\clemson@ulon}
\AddToHook{cmd/tableofcontents/before}{\clemson@incontentstrue}
\AddToHook{cmd/tableofcontents/after}{\clemson@incontentsfalse}
\AddToHook{cmd/listoffigures/before}{\clemson@incontentstrue}
\AddToHook{cmd/listoffigures/after}{\clemson@incontentsfalse}
\AddToHook{cmd/listoftables/before}{\clemson@incontentstrue}
\AddToHook{cmd/listoftables/after}{\clemson@incontentsfalse}
% \email{addr}: a mailto link whose text is the address (Clemson Links page);
% \detokenize keeps an underscore from being read as math in the output.
% Meets: WCAG 2.1 SC 2.4.4.
\providecommand{\email}[1]{\href{mailto:#1}{\detokenize{#1}}}
% The contents and the two lists get a bookmark
% Meets: Tagged PDF BPG 1.0.1 7.2.
\newcommand*{\clemson@turnpage}{\if@openright\cleardoublepage\else\clearpage\fi}
\newcommand*{\clemson@bookmark}[2]{\ifdefined\chapter\clemson@turnpage\pdfbookmark[0]{#1}{#2}\else\pdfbookmark[1]{#1}{#2}\fi}
\AddToHook{cmd/tableofcontents/before}[./bookmark]{\clemson@bookmark{\contentsname}{clemson.toc}}
\AddToHook{cmd/listoffigures/before}[./bookmark]{\clemson@bookmark{\listfigurename}{clemson.lof}}
\AddToHook{cmd/listoftables/before}[./bookmark]{\clemson@bookmark{\listtablename}{clemson.lot}}
% The bibliography's starred heading
% Meets: ISO 14289-2:2024 8.2.5.8; Tagged PDF BPG 1.0.1 4.1.4, 7.2.
\newif\ifclemson@bib
\AddToHook{env/thebibliography/before}[./bookmark]{\clemson@bibtrue}
\AddToHook{cmd/section/after}[./bookmark]{\ifclemson@bib\clemson@bibfalse
  \addcontentsline{toc}{section}{\ifdefined\refname\refname\else\bibname\fi}\fi}
\AddToHook{cmd/chapter/after}[./bookmark]{\ifclemson@bib\clemson@bibfalse
  \addcontentsline{toc}{chapter}{\bibname}\fi}
