% clemson.sty: accessible (tagged, PDF/UA-2) LaTeX in one package.
% Clemson University, CCIT Internal Operations, ADA Compliance Team.
%
% What you write; the package cannot do these for you (details in README.md):
%   1. % !TEX program = lualatex  on the first line, so editors pick LuaLaTeX.
%   2. \DocumentMetadata{lang=en-US, pdfstandard=ua-2, tagging=on,
%        check-tagging-status} above \documentclass. It turns tagging on and
%      names the standard.
%   3. \usepackage{clemson} after your other packages; it loads hyperref. A
%      package that must follow hyperref (cleveref) goes after it, and a
%      hyperref option that works only at load time goes in
%      \PassOptionsToPackage{...}{hyperref} above it.
%   4. alt={...} on every \includegraphics and tikzpicture, and the header rows
%      or columns of every tabular (\tagpdfsetup{table/header-rows={1}}).
% What the package does, with article, report, book or a class built on them:
% stops the build unless LuaLaTeX, LaTeX 2026-06-01 or newer and
% \DocumentMetadata with tagging are in use (tagging=draft builds, with a
% warning); puts every formula's MathML in the tag tree and loads unicode-math
% (its characters); defines theorem, lemma, proposition, corollary, definition,
% example, remark
% and algorithm (LaTeX supplies amsthm's commands itself under tagging), loads
% enotez (endnotes), graphicx, float ([H] placement), babel (add languages
% with \babelprovide), hyperref and lua-ul (links that leave the document
% underlined by LaTeX; all links black, no viewer box);
% tags the title as the only H1 with the headings one level down and the
% abstract as a Sect with an H2; keeps each figure and table in the tag tree
% where it is written; writes Scope, spans and Headers on the cells of every
% tabular (not longtable or layout tables); sets left-aligned text (option
% justified turns that off); tags \strong and babel language switches; keeps
% the MathML file list right when the file name holds a comma; adds NoteType
% to footnotes; adds bookmarks for the front matter and the bibliography,
% \email and the word QED at the end of a proof. The rest is LaTeX's own
% tagging.
% Meets: ISO 14289-2:2024 (PDF/UA-2) machine rules, checked with veraPDF
% --flavour ua2; the checks by hand in README.md cover the rest.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{clemson}[2026/09/29 v2.2 Accessible LaTeX (Clemson A11Y)]
% One option: justified keeps LaTeX's justified text (TEXT ALIGNMENT below).
\newif\ifclemson@justified
\DeclareKeys[clemson]{justified .if = clemson@justified, justified .usage = load}
\ProcessKeyOptions[clemson]

%------------------------------------------------------------------------------
% TOOLCHAIN GUARDS
%------------------------------------------------------------------------------
% An untagged PDF looks normal and fails the accessibility check later, and
% LaTeX writes one with no warning: pdfstandard=ua-2 alone does not turn tagging
% on. So the build stops, and no PDF is written, unless LaTeX is 2026-06-01 or
% newer, the engine is LuaLaTeX (the only one that writes MathML; XeTeX cannot
% tag reliably) and \DocumentMetadata is present with tagging active when the
% document starts. tagging=draft passes that test and skips the tag tree, so
% the end of the run warns.
% Meets: ISO 14289-2:2024 6.2 (Marked), 8.2.1 (structure), 8.2.5.29.1 (MathML,
% as the PDF Association Math BPG 1.0 reads it; veraPDF tests only 8.2.5.29-1).
\RequirePackage{iftex}
\RequireLuaTeX
\ExplSyntaxOn
\msg_new:nnn { clemson } { old-latex }
  { LaTeX~2026-06-01~or~newer~is~required.~Install~TeX~Live~2026~(MacTeX~2026),
    ~then~run~'sudo~tlmgr~update~--self~--all'. }
\msg_new:nnn { clemson } { not-tagged }
  { PDF~tagging~is~not~active.~Put~tagging=on~in~the~\string\DocumentMetadata\c_space_tl block~above~\string\documentclass\c_space_tl and~remove~tagging=off. }
\msg_new:nnn { clemson } { draft }
  { tagging=draft:~this~PDF~has~NO~tag~tree~and~is~not~accessible.~Remove~
    draft~from~\string\DocumentMetadata\c_space_tl before~you~share~it. }
\IfFormatAtLeastTF { 2026-06-01 } { } { \msg_fatal:nn { clemson } { old-latex } }
\AddToHook { begindocument }
  { \tag_if_active:F { \msg_fatal:nn { clemson } { not-tagged } } }
\AddToHook { enddocument/end }
  { \tag_if_active:F { \msg_warning:nn { clemson } { draft } } }
\ExplSyntaxOff
% The kernel's own check that \DocumentMetadata was given. It comes after the
% hooks above: it ends the package when the block is missing, and the
% begindocument hook then stops the build with the message that names it.
\NeedsDocumentMetadata

%------------------------------------------------------------------------------
% FONTS AND MATH
%------------------------------------------------------------------------------
% LuaLaTeX already sets Latin Modern in Unicode (TU) encoding, with its small
% caps and optical sizes, so no font command is needed. The tagging project
% asks for unicode-math with math: it gives LaTeX's MathML the right characters
% (\int, \sum, \hbar). It loads fontspec and amsmath. Do not load amssymb or bm
% after it; write \symbf{v}, \symbfit{v} and \symcal{A} for bold and script
% letters. A document that loads lua-unicode-math first keeps it and gets
% fontspec, which defines \strong. Meets: ISO 14289-2:2024 8.2.5.29.1 (MathML;
% Math in PDF BPG 1.0 p. 4).
\IfPackageLoadedTF{lua-unicode-math}{\RequirePackage{fontspec}}{\RequirePackage{unicode-math}}
% Every formula's MathML goes into the tag tree as structure elements
% (mathml-SE), the form the tagging project and the Math BPG put first and
% the one Acrobat hands to a screen reader; LaTeX's own default attaches a
% file per formula instead. A document that also wants the file writes
% \tagpdfsetup{math/setup={mathml-SE,mathml-AF}} after this package.
% Meets: ISO 14289-2:2024 8.2.5.29.1 (MathML; Math in PDF BPG 1.0 pp. 4-5).
\tagpdfsetup{math/setup=mathml-SE}
% \strong (fontspec) is tagged Strong through the kernel's inline socket, the
% way LaTeX tags \emph as Em; \textbf only changes the letters, so bold used
% for meaning is lost to a screen reader. Keep it to words in a sentence; the
% LINKS block lets it sit in a heading without breaking the bookmark.
% REMOVE WHEN: LaTeX ships \strongemph (latex2e issue 1620); drop these hooks.
% Meets: WCAG 2.1 SC 1.3.1 (failure F2); ISO 32000-2:2020 Table 368 (Strong).
\AddToHook{cmd/strong/before}{\leavevmode\UseTaggingSocket{inline/begin}{tag=Strong}}
\AddToHook{cmd/strong/after}{\UseTaggingSocket{inline/end}}

%------------------------------------------------------------------------------
% THEOREMS
%------------------------------------------------------------------------------
% LaTeX has amsthm's \newtheorem, \theoremstyle and proof built in and never
% reads amsthm.sty under \DocumentMetadata. Each theorem-like block is a Sect
% whose head is a Caption with a Lbl number. House style: a proof ends with
% the word QED, read aloud; LaTeX's square is drawn with rules and says
% nothing. Delete the \qedsymbol line for the square.
% Meets: ISO 32000-2:2020 14.8.4.8.4 (Caption); ISO 14289-2:2024 8.2.5.27.
\renewcommand{\qedsymbol}{\textup{QED}}
% When the document starts, LaTeX's \newtheorem defines theorem, lemma,
% proposition, corollary, definition, example and remark on one counter and
% algorithm on its own, each only if the preamble has not defined it (a
% convenience). algorithm is theorem-like because the algorithm package is
% listed as currently incompatible; write the steps in an algorithmic body.
% Each name is also its \autoref name, so \autoref{lem:x} reads "Lemma 2".
% Meets: ISO 32000-2:2020 14.8.4.8.4 (Caption), 14.8.4.8.2 (L); WCAG 2.1 2.4.4.
\newcommand*{\clemson@theorem}[3]{%
  \@ifundefined{#2}{%
    \theoremstyle{#1}%
    \@ifundefined{c@theorem}{\newtheorem{#2}{#3}}{\newtheorem{#2}[theorem]{#3}}%
    \expandafter\providecommand\csname #2autorefname\endcsname{#3}%
  }{}}
\AddToHook{begindocument/before}[./theorems]{%
  \@ifundefined{theorem}{\theoremstyle{plain}\newtheorem{theorem}{Theorem}}{}%
  \clemson@theorem{plain}{lemma}{Lemma}%
  \clemson@theorem{plain}{proposition}{Proposition}%
  \clemson@theorem{plain}{corollary}{Corollary}%
  \clemson@theorem{definition}{definition}{Definition}%
  \clemson@theorem{definition}{example}{Example}%
  \clemson@theorem{remark}{remark}{Remark}%
  \@ifundefined{algorithm}{\theoremstyle{definition}\newtheorem{algorithm}{Algorithm}}{}%
  \providecommand*{\algorithmautorefname}{Algorithm}%
  \theoremstyle{plain}}

%------------------------------------------------------------------------------
% PICTURES
%------------------------------------------------------------------------------
% graphicx gives \includegraphics; LaTeX's tagging code turns its alt,
% actualtext and artifact keys into a Figure with Alt, a Span with ActualText
% or an artifact. Without a key LaTeX warns and uses the file name as the Alt,
% which veraPDF passes, so each alt text is the author's job. The picture
% folder is the document's choice (\graphicspath in main.tex).
% Meets, with the author's alt text: ISO 14289-2:2024 8.2.5.28.2; WCAG 2.1
% SC 1.1.1; ISO 32000-2:2020 14.8.4.8.5; Tagged PDF BPG 1.0.1 5.5.2.
\RequirePackage{graphicx}

%------------------------------------------------------------------------------
% FLOATS
%------------------------------------------------------------------------------
% LaTeX tags each figure and table as an Aside with its Caption first and by
% default moves it to figures and tables sections at the end of the tree:
% floats are consultation objects, and PDF 1.7 readers show an Aside as a
% Note. float/here, a documented key, keeps every float's Aside where it is
% written ([H] floats stay there anyway), so the tag order matches the page,
% which Clemson's PDF manual checks require and ISO 32000-2:2020 14.8.2.5.1
% asks for. Meets: Clemson PDF manual checks (tags, reading order); ISO
% 32000-2:2020 14.8.2.5.1; WCAG 2.1 SC 1.3.2.
\tagpdfsetup{float/here}
% Figures and tables print where they are written: the float package's [H]
% is their default placement; \floatplacement{figure}{tbp} lets figures float.
% float is listed incompatible (status 2): \newfloat and \restylefloat break
% the tagging (latex-lab-firstaid 2.8), [!] and [] stop the build with [H] as
% default, and an [H] float with its \caption in a minipage fails PDF/UA-2
% 8.2.5.27 (tagging issue 1549). Meets: Clemson PDF manual checks (tag order
% matches the page).
\RequirePackage{float}
\floatplacement{figure}{H}
\floatplacement{table}{H}
% A11Y WORKAROUND. A float right after a list or a displayed formula otherwise
% stops the build (tagging issue 1532) or, with no warning, leaves an [H]
% float's Caption or a floating table's body outside the Aside. The float
% package drops an [H] figure* or table* in one column, so there those float.
% REMOVE WHEN: issue 1532 is fixed (the \par parts only).
% Meets: ISO 14289-2:2024 8.2.5.27; ISO 32000-2:2020 14.8.4.8.4 (Caption).
\AddToHook{env/figure/begin}{\par}
\AddToHook{env/table/begin}{\par}
\AddToHook{env/figure*/begin}%
  {\par\if@twocolumn\else\floatplacement{figure}{!htbp}\fi}
\AddToHook{env/table*/begin}%
  {\par\if@twocolumn\else\floatplacement{table}{!htbp}\fi}

%------------------------------------------------------------------------------
% TITLE AND HEADINGS
%------------------------------------------------------------------------------
% The printed title is the only H1 and every heading moves down one level, as
% in the Graduate School's Word template: chapter H2 to subparagraph H6 in
% report and book (paragraph and subparagraph share H6, the last HTML level),
% section H2 to subparagraph H6 in article. Clemson's headings rule and
% PDF/UA-1 7.4.2, which Acrobat's checker applies, require H1 first and no
% skipped level; veraPDF's PDF/UA-2 rules do not test heading order, so it is
% a check by hand. The plug puts the whole title of LaTeX's \maketitle in one
% H1, one Span per line; a class with its own title page (ClemsonThesis.cls)
% tags its title as text and leaves no H1. REMOVE WHEN: issue 1625 lands.
% Meets: Clemson Digital Accessibility, Headings; ISO 14289-1:2014 7.4.2;
% WCAG 2.1 SC 1.3.1; Tagged PDF BPG 1.0.1 4.2.2.2 (H1 title, the only one).
\ifdefined\chapter
  \AssignStructureRole{sec/0/title}{H2}
  \AssignStructureRole{sec/1/title}{H3}
  \AssignStructureRole{sec/2/title}{H4}
  \AssignStructureRole{sec/3/title}{H5}
  \AssignStructureRole{sec/4/title}{H6}
\else
  \AssignStructureRole{sec/1/title}{H2}
  \AssignStructureRole{sec/2/title}{H3}
  \AssignStructureRole{sec/3/title}{H4}
  \AssignStructureRole{sec/4/title}{H5}
  \AssignStructureRole{sec/5/title}{H6}
\fi
\NewTaggingSocketPlug{title}{clemson-h1}
  {\tagstructbegin{tag=H1}\AssignStructureRole{para/textblock}{Span}#2\tagstructend}
\AssignTaggingSocketPlug{title}{clemson-h1}
% ltx-talk (the tagged slide class) tags its title page as a Title element
% and every frame title as H4; its manual (14.2) calls that level open. A
% deck gets the same shape as an article: the title H1 with its paragraph
% a Span, as in the plug above, and each frame title H2. A deck that uses
% \section gets those as H2 from the roles above, so the first \section
% moves the frame titles to H3. The class keeps its own tag namespace
% current, so the new-tag lines land there.
% REMOVE WHEN: ltx-talk settles its heading levels.
% Meets: Clemson Digital Accessibility, Headings; ISO 14289-1:2014 7.4.2.
\ExplSyntaxOn
\IfClassLoadedTF { ltx-talk }
  {
    \EditInstance { titlepage-element } { title }
      {
        tag-begin = \tag_struct_begin:n { tag = H1 }
                    \AssignStructureRole { para/textblock } { Span } ,
        tag-end   = \tag_struct_end:
      }
    \tagpdfsetup { role/new-tag = frametitle/H2 }
    \AddToHook { cmd/section/before } [ clemson ]
      { \tagpdfsetup { role/new-tag = frametitle/H3 } }
  }
  { }
\ExplSyntaxOff
% A11Y WORKAROUND: at the last page LaTeX 2026-06-01 hands the text of \title
% to hyperref's pdftitle key without braces, and that key reads a comma list
% (one title per language), so "A, B" reaches dc:title as "A". This chunk
% runs first and sets the key from the same text inside braces, as the
% 2026-11-01 kernel does; the kernel's chunk then finds it set and skips.
% REMOVE WHEN: LaTeX 2026-11-01 is the installed release (tagging issue 1594).
% Meets: ISO 14289-2:2024 8.11.1 (dc:title in the XMP metadata).
\ExplSyntaxOn
\IfFormatAtLeastTF { 2026-11-01 } { }
  {
    \str_new:N \l__clemson_title_str
    \AddToHook { shipout/lastpage } [ clemson/title ]
      {
        \tl_if_empty:eT { \GetDocumentProperty { hyperref/pdftitle } }
          {
            \group_begin:
            \cs_set_eq:NN \thanks \use_none:n
            \str_set:Ne \l__clemson_title_str
              { \text_purify:n { \g__tag_title_title_tl } }
            \str_if_empty:NF \l__clemson_title_str
              {
                \keys_set:ne { hyp }
                  { pdftitle = {{ \exp_not:V \l__clemson_title_str }} }
              }
            \group_end:
          }
      }
    \DeclareHookRule { shipout/lastpage } { clemson/title } { before }
      { latex-lab-testphase-title }
  }
\ExplSyntaxOff

%------------------------------------------------------------------------------
% ABSTRACT
%------------------------------------------------------------------------------
% LaTeX tags the article abstract as a BlockQuote and report's title-page one
% as plain text (tagging issue 1327, open), with no heading. This keeps the
% class's own layout, tags the block Sect with an H2 heading, the level after
% the H1 title (Clemson's headings rule; Graduate School template), and
% bookmarks it inside the Sect; in report it prints in the text flow. The
% \par comes first, or LaTeX 2026-06-01 stops ("text para hooks differ")
% after a center block or a list. Article and report only.
% REMOVE WHEN: issue 1327 gives the abstract its own tagging.
% Meets: Clemson Digital Accessibility, Headings; ISO 14289-1:2014 7.4.2;
% ISO 32000-2:2020 14.8.4.4 (Sect), 14.8.4.5; Tagged PDF BPG 1.0.1 4.2.2, 7.2.
\newcommand*{\clemson@abstract}{%
  \renewenvironment{abstract}{%
    \par
    \begin{displayblock}[tag-name=Sect, tagging-recipe=standalone]%
    \pdfbookmark[1]{\abstractname}{clemson.abstract}%
    \small
    \begin{center}\AssignStructureRole{para/textblock}{H2}%
      \bfseries\abstractname\vspace{-.5em}\vspace{\z@}\end{center}%
    \begin{quotation}[tagging-recipe=basic]%
  }{\end{quotation}\end{displayblock}}}
\IfClassLoadedTF{article}{\clemson@abstract}{\IfClassLoadedTF{report}{\clemson@abstract}{}}

%------------------------------------------------------------------------------
% TEXT ALIGNMENT
%------------------------------------------------------------------------------
% Clemson's text page: "As a best practice, use left-aligned text." (WCAG 2.1
% SC 1.4.8 is Level AAA, not required at AA.) \raggedright is LaTeX's own para
% instance and tags body paragraphs TextAlign Start. The class's indent is
% put back (the instance zeroes it) and \\ stays a plain line break, since the
% one \raggedright installs ends the paragraph. Footnotes get the same setting
% through the fntext/para hook; minipage, parbox, float and p-column text
% stays justified, as LaTeX resets it there. Theorem and proof bodies keep
% their justified templates; option justified keeps LaTeX's everywhere.
% Meets: Clemson Digital Accessibility, Text; WCAG 2.1 SC 1.4.8 (Level AAA).
\newcommand*{\clemson@ragged}{\edef\clemson@parindent{\the\parindent}%
  \raggedright\let\\\@normalcr\setlength{\parindent}{\clemson@parindent}}
\ifclemson@justified\else
  \AtBeginDocument{\clemson@ragged}
  \AddToHook{fntext/para}{\clemson@ragged}
\fi

%------------------------------------------------------------------------------
% ENDNOTES
%------------------------------------------------------------------------------
% \endnote{...} writes an endnote and \printendnotes prints them (nothing when
% there are none). The mark links to the note and, with backref, the note's
% number links back. The notes are an enumerate list, since they are numbered;
% the heading's optional argument puts "Notes" in the contents and bookmarks
% at the heading itself (totoc=auto pointed before it). Roman marks stay
% apart from arabic footnote marks. The notes are a list with links, not
% FENote elements: enotez is listed partially compatible (tagging issue 728).
% Meets: ISO 14289-2:2024 8.2.5.8, 8.2.5.25; Tagged PDF BPG 1.0.1 4.2.8.
\RequirePackage{enotez}
\DeclareInstance{enotez-list}{enumerate}{list}{list-type = enumerate}
\setenotez{backref=true, list-style=enumerate, counter-format=roman,
  list-heading={\@ifundefined{chapter}{\section*[#1]{#1}}{\chapter*[#1]{#1}}}}

%------------------------------------------------------------------------------
% MATHML FILE NAME
%------------------------------------------------------------------------------
% A11Y WORKAROUND. When LaTeX reads MathML from files (mathml-AF, the default
% with no math/setup key, or {mathml-SE,mathml-AF}) it expands the job name
% into its comma list of file names: "a,b" loses every formula's MathML with
% no error and "a, b" stops the build. The list is set again with \jobname
% unexpanded at begindocument/before, after any math/setup; an empty list
% (mathml-SE alone, or math/mathml/sources=) stays empty. Reads latex-lab's
% \l__tag_math_mathml_files_clist. REMOVE WHEN: a,b.tex with mathml-AF logs
% "reading mathml file a,b-luamml-mathml" without this block.
% Meets: ISO 14289-2:2024 8.2.5.29.1 (MathML for every formula).
\ExplSyntaxOn
\AddToHook { begindocument/before }
  {
    \str_if_in:NnT \c_sys_jobname_str { , }
      {
        \clist_if_empty:NF \l__tag_math_mathml_files_clist
          {
            \tagpdfsetup { math/mathml/sources = { \jobname-mathml , \jobname-luamml-mathml } }
            \PackageInfo { clemson } { job~name~holds~a~comma:~MathML~file~list~set~again }
          }
      }
  }
\ExplSyntaxOff

%------------------------------------------------------------------------------
% LANGUAGES
%------------------------------------------------------------------------------
% babel is loaded here with no language: it takes the main language from the
% lang key of \DocumentMetadata (babel 25.8 and later). A document adds the
% languages it needs with \babelprovide[import]{french} after this package, or
% loads babel with options before it. Then \foreignlanguage{french}{...} marks
% a phrase and the otherlanguage environment a passage, and both hyphenate
% in that language. Meets: WCAG 2.1 SC 3.1.2; ISO 32000-2:2020 14.9.2.
\RequirePackage{babel}
% A11Y WORKAROUND. babel writes no /Lang. Its "foreign" hook wraps the
% argument of \foreignlanguage (one paragraph at most) in a Span with the
% kernel's inline socket. Its afterextras hook runs at every switch: for
% another language it sets tagpdf's text/lang, so each element opened from
% then on has /Lang; back in the main language it clears the key only
% when the element that was open at the first switch is open again, because
% an element without /Lang inherits its parent's (ISO 32000-2:2020 14.9.2.3).
% The l3text line keeps the language name out of heading and contents /T
% strings and the PDF title; hyperref strips it from bookmarks itself.
% REMOVE WHEN: babel writes /Lang itself (babel discussion 357) or tagpdf
% gets a Lang interface for marked content (tagging issue 988).
\ExplSyntaxOn
\AddBabelHook { clemson } { foreign }
  { \BabelWrapText { \UseTaggingSocket { inline/begin } { tag=Span , lang=\BCPdata{tag} }
      ##1 \UseTaggingSocket { inline/end } } }
\tl_new:N \l__clemson_lang_struct_tl
\AddBabelHook { clemson } { afterextras }
  {
    \cs_if_eq:NNTF \localename \mainlocalename
      {
        \tl_if_empty:NF \l__clemson_lang_struct_tl
          {
            \str_if_eq:eeTF { \tag_get:n { struct_num } } { \l__clemson_lang_struct_tl }
              {
                \tl_clear:N \l__clemson_lang_struct_tl
                \tagpdfsetup { text/lang = }
              }
              { \tagpdfsetup { text/lang = \BCPdata{tag} } }
          }
      }
      {
        \tl_if_empty:NT \l__clemson_lang_struct_tl
          { \tl_set:Ne \l__clemson_lang_struct_tl { \tag_get:n { struct_num } } }
        \tagpdfsetup { text/lang = \BCPdata{tag} }
      }
  }
\text_declare_purify_equivalent:Nn \foreignlanguage { \use_ii:nn }
\ExplSyntaxOff

%------------------------------------------------------------------------------
% TABLE CELLS
%------------------------------------------------------------------------------
% A11Y WORKAROUND. LaTeX writes Scope, ColSpan and RowSpan as attribute
% classes, which ISO 32000-2:2020 14.7.6.2 counts as attached to the cell and
% veraPDF reads. PAC ignores classes (tagging-project Discussion 1324) and
% Acrobat's Table Editor shows "scope none", so at the end of each tabular
% every cell also gets them as a direct /A with /O /Table. No standard asks
% for this copy. Headers are different: LaTeX writes none (see below).
% Meets: ISO 32000-2:2020 14.8.4.8.3 (TH, TD); 14.8.5.7 (Table 384, optional).
\ExplSyntaxOn
% Headers holds "row IDs followed by column IDs" (ISO 32000-2 Table 384),
% each list nearest first. The 14.8.4.8.3 search stops at the first data
% cell past a header, so below a second group row the top headers are lost.
% Here the top header rows head every data row and a group row (a lower
% header row, or a one-cell row under the top headers) heads the rows below
% it up to the next group; header columns work the same way from the left.
% Meets: ISO 14289-2:2024 8.2.5.26; Tagged PDF BPG 1.0.1 5.4.1 (complex tables).
\prop_new:N  \l__hdrs_grid_prop
\prop_new:N  \l__hdrs_minr_prop
\prop_new:N  \l__hdrs_maxr_prop
\prop_new:N  \l__hdrs_minc_prop
\prop_new:N  \l__hdrs_maxc_prop
\prop_new:N  \l__hdrs_scope_prop
\prop_new:N  \l__hdrs_hrow_prop
\prop_new:N  \l__hdrs_hcol_prop
\prop_new:N  \l__hdrs_fullrow_prop
\prop_new:N  \l__hdrs_fullcol_prop
\prop_new:N  \l__hdrs_untagged_prop
\seq_new:N   \l__hdrs_order_seq
\seq_new:N   \l__hdrs_cells_seq
\clist_new:N \l__hdrs_row_clist
\clist_new:N \l__hdrs_lines_clist
\clist_new:N \l__hdrs_rowh_clist
\clist_new:N \l__hdrs_colh_clist
\tl_new:N    \l__hdrs_table_tl
\tl_new:N    \l__hdrs_cell_tl
\tl_new:N    \l__hdrs_tmp_tl
\tl_new:N    \l__hdrs_scope_tl
\tl_new:N    \l__hdrs_dict_tl
\str_new:N   \l__hdrs_class_str
\int_new:N   \l__hdrs_rows_int
\int_new:N   \l__hdrs_cols_int
\int_new:N   \l__hdrs_idx_int
\int_new:N   \l__hdrs_top_int
\int_new:N   \l__hdrs_left_int
\int_new:N   \l__hdrs_line_int
\int_new:N   \l__hdrs_r_int
\int_new:N   \l__hdrs_rr_int
\int_new:N   \l__hdrs_c_int
\int_new:N   \l__hdrs_cc_int
\bool_new:N  \l__hdrs_part_bool

% The grid maps "row,col" to a cell's structure number, so a cell fills every
% slot it spans. Rows come from the module's cell list; a negative entry is a
% slot a \multicolumn covers, and an untagged slot is one a table/multirow
% cell above covers. The first slot of a cell is its top left corner.
\cs_new:Npn \__hdrs_at:nn #1 #2
  { \prop_item:Ne \l__hdrs_grid_prop { #1 , #2 } }
\cs_new_protected:Npn \__hdrs_record:nnn #1 #2 #3 % row, column, cell
  {
    \prop_put:Nnn \l__hdrs_grid_prop { #1 , #2 } { #3 }
    \prop_if_in:NnTF \l__hdrs_minr_prop { #3 }
      {
        \prop_put:Nnn \l__hdrs_maxr_prop { #3 } { #1 }
        \prop_put:Nne \l__hdrs_maxc_prop { #3 }
          { \int_max:nn { #2 } { \prop_item:Nn \l__hdrs_maxc_prop { #3 } } }
      }
      {
        \prop_put:Nnn \l__hdrs_minr_prop { #3 } { #1 }
        \prop_put:Nnn \l__hdrs_maxr_prop { #3 } { #1 }
        \prop_put:Nnn \l__hdrs_minc_prop { #3 } { #2 }
        \prop_put:Nnn \l__hdrs_maxc_prop { #3 } { #2 }
        \seq_put_right:Nn \l__hdrs_order_seq { #3 }
      }
  }
\cs_generate_variant:Nn \__hdrs_record:nnn { nnV }
\cs_new_protected:Npn \__hdrs_slot:nn #1 #2 % row, column
  {
    \prop_if_in:NnTF \l__hdrs_untagged_prop { #1 , #2 }
      {
        \tl_set:Ne \l__hdrs_cell_tl
          { \__hdrs_at:nn { \int_eval:n { #1 - 1 } } { #2 } }
      }
      {
        \int_incr:N \l__hdrs_idx_int
        \tl_set:Ne \l__hdrs_cell_tl
          { \clist_item:Nn \l__hdrs_row_clist { \l__hdrs_idx_int } }
        \tl_if_empty:NF \l__hdrs_cell_tl
          { \tl_set:Ne \l__hdrs_cell_tl { \int_abs:n { \l__hdrs_cell_tl } } }
      }
    \tl_if_empty:NF \l__hdrs_cell_tl
      { \__hdrs_record:nnV { #1 } { #2 } \l__hdrs_cell_tl }
  }
\cs_new_protected:Npn \__hdrs_geometry:n #1 % cell
  {
    \int_set:Nn \l__hdrs_r_int  { \prop_item:Nn \l__hdrs_minr_prop { #1 } }
    \int_set:Nn \l__hdrs_rr_int { \prop_item:Nn \l__hdrs_maxr_prop { #1 } }
    \int_set:Nn \l__hdrs_c_int  { \prop_item:Nn \l__hdrs_minc_prop { #1 } }
    \int_set:Nn \l__hdrs_cc_int { \prop_item:Nn \l__hdrs_maxc_prop { #1 } }
  }

% Header cells are found by the classes the table code gave them: TH-col,
% TH-row or TH-both. A header row is a row where a column or corner header
% starts; a full row is one cell as wide as the table. Columns likewise.
\cs_new_protected:Npn \__hdrs_mark:Nn #1 #2
  { \prop_put:Nen #1 { \int_use:N #2 } { } }
\cs_new_protected:Npn \__hdrs_read_cell:n #1 % cell
  {
    \__hdrs_geometry:n { #1 }
    \tl_clear:N \l__hdrs_tmp_tl
    \tag_get:nnN { #1 } { struct_C } \l__hdrs_tmp_tl
    \str_set:NV \l__hdrs_class_str \l__hdrs_tmp_tl
    \tl_clear:N \l__hdrs_scope_tl
    \str_if_in:NnTF \l__hdrs_class_str { /TH-both }
      { \tl_set:Nn \l__hdrs_scope_tl { Both } }
      {
        \str_if_in:NnTF \l__hdrs_class_str { /TH-col }
          { \tl_set:Nn \l__hdrs_scope_tl { Column } }
          {
            \str_if_in:NnT \l__hdrs_class_str { /TH-row }
              { \tl_set:Nn \l__hdrs_scope_tl { Row } }
          }
      }
    \tl_if_empty:NF \l__hdrs_scope_tl
      { \prop_put:NnV \l__hdrs_scope_prop { #1 } \l__hdrs_scope_tl }
    \str_case:Vn \l__hdrs_scope_tl
      {
        { Column } { \__hdrs_mark:Nn \l__hdrs_hrow_prop \l__hdrs_r_int }
        { Row }    { \__hdrs_mark:Nn \l__hdrs_hcol_prop \l__hdrs_c_int }
        { Both }
          {
            \__hdrs_mark:Nn \l__hdrs_hrow_prop \l__hdrs_r_int
            \__hdrs_mark:Nn \l__hdrs_hcol_prop \l__hdrs_c_int
          }
      }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn { \l__hdrs_c_int } = { 1 } }
      { \int_compare_p:nNn { \l__hdrs_cc_int } = { \l__hdrs_cols_int } }
      { \__hdrs_mark:Nn \l__hdrs_fullrow_prop \l__hdrs_r_int }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn { \l__hdrs_r_int } = { 1 } }
      { \int_compare_p:nNn { \l__hdrs_rr_int } = { \l__hdrs_rows_int } }
      { \__hdrs_mark:Nn \l__hdrs_fullcol_prop \l__hdrs_c_int }
  }

% #3 gets the size of the top (left) header block: the header lines from line
% 1 on, up to a full line that follows a line that is not full.
\cs_new_protected:Npn \__hdrs_block:NNN #1 #2 #3 % header, full lines; int
  {
    \int_zero:N #3
    \bool_set_false:N \l__hdrs_part_bool
    \bool_while_do:nn
      {
        \prop_if_in_p:Ne #1 { \int_eval:n { #3 + 1 } }
        && ! ( \l__hdrs_part_bool
               && \prop_if_in_p:Ne #2 { \int_eval:n { #3 + 1 } } )
      }
      {
        \int_incr:N #3
        \prop_if_in:NeF #2 { \int_use:N #3 }
          { \bool_set_true:N \l__hdrs_part_bool }
      }
  }

% The lines (rows or columns) to search for a cell that starts on line #1,
% nearest first. A cell on a data line gets the nearest group, then the top
% block. A group cell gets no headers from above it: Table 384 hands a
% header's own Headers on to every cell that names it, so the column headers
% over a group cell as wide as the table would apply to every column.
% Meets: ISO 32000-2:2020 14.8.5.7 (Table 384, Headers).
\cs_new_protected:Npn \__hdrs_lines:nNN #1 #2 #3 % first line, block, headers
  {
    \clist_clear:N \l__hdrs_lines_clist
    \int_set:Nn \l__hdrs_line_int { #1 - 1 }
    \int_compare:nNnT { #1 } > { #2 }
      {
        \prop_if_in:NeF #3 { #1 }
          {
            \bool_until_do:nn
              {
                \int_compare_p:n { \l__hdrs_line_int <= #2 }
                || \prop_if_in_p:Ne #3 { \int_use:N \l__hdrs_line_int }
              }
              { \int_decr:N \l__hdrs_line_int }
          }
        \bool_while_do:nn
          {
            \int_compare_p:n { \l__hdrs_line_int > #2 }
            && \prop_if_in_p:Ne #3 { \int_use:N \l__hdrs_line_int }
          }
          {
            \clist_put_right:Ne \l__hdrs_lines_clist
              { \int_use:N \l__hdrs_line_int }
            \int_decr:N \l__hdrs_line_int
          }
        \prop_if_in:NeTF #3 { #1 }
          { \int_zero:N \l__hdrs_line_int }
          { \int_set_eq:NN \l__hdrs_line_int #2 }
      }
    \int_step_inline:nnnn { \l__hdrs_line_int } { -1 } { 1 }
      { \clist_put_right:Nn \l__hdrs_lines_clist { ##1 } }
  }

% Add the cell in slot (#2, #3) to list #4 if it is a header of scope #5 or
% Both and is not cell #1 itself.
\cs_new_protected:Npn \__hdrs_add:nnnNn #1 #2 #3 #4 #5
  {
    \tl_set:Ne \l__hdrs_tmp_tl { \__hdrs_at:nn { #2 } { #3 } }
    \tl_if_empty:NF \l__hdrs_tmp_tl
      {
        \str_if_eq:eeF { \l__hdrs_tmp_tl } { #1 }
          {
            \tl_set:Ne \l__hdrs_scope_tl
              { \prop_item:NV \l__hdrs_scope_prop \l__hdrs_tmp_tl }
            \bool_lazy_or:nnT
              { \str_if_eq_p:ee { \l__hdrs_scope_tl } { #5 } }
              { \str_if_eq_p:ee { \l__hdrs_scope_tl } { Both } }
              {
                \clist_if_in:NVF #4 \l__hdrs_tmp_tl
                  { \clist_put_right:NV #4 \l__hdrs_tmp_tl }
              }
          }
      }
  }

% One cell's attribute dictionary. \tag_struct_gput:nnn with the attribute
% key writes it as an object and adds it to /A; the /C classes stay.
\cs_new_protected:Npn \__hdrs_do_cell:n #1 % cell
  {
    \__hdrs_geometry:n { #1 }
    \tl_clear:N \l__hdrs_dict_tl
    \prop_get:NnNT \l__hdrs_scope_prop { #1 } \l__hdrs_scope_tl
      { \tl_put_right:Ne \l__hdrs_dict_tl { ~/Scope~/ \l__hdrs_scope_tl } }
    \int_compare:nNnT { \l__hdrs_cc_int } > { \l__hdrs_c_int }
      {
        \tl_put_right:Ne \l__hdrs_dict_tl
          { ~/ColSpan~ \int_eval:n { \l__hdrs_cc_int - \l__hdrs_c_int + 1 } }
      }
    \int_compare:nNnT { \l__hdrs_rr_int } > { \l__hdrs_r_int }
      {
        \tl_put_right:Ne \l__hdrs_dict_tl
          { ~/RowSpan~ \int_eval:n { \l__hdrs_rr_int - \l__hdrs_r_int + 1 } }
      }
    \clist_clear:N \l__hdrs_rowh_clist
    \__hdrs_lines:nNN { \int_use:N \l__hdrs_c_int }
      \l__hdrs_left_int \l__hdrs_hcol_prop
    \clist_map_inline:Nn \l__hdrs_lines_clist
      {
        \int_step_inline:nnn { \l__hdrs_r_int } { \l__hdrs_rr_int }
          {
            \__hdrs_add:nnnNn { #1 } { ####1 } { ##1 }
              \l__hdrs_rowh_clist { Row }
          }
      }
    \clist_clear:N \l__hdrs_colh_clist
    \__hdrs_lines:nNN { \int_use:N \l__hdrs_r_int }
      \l__hdrs_top_int \l__hdrs_hrow_prop
    \clist_map_inline:Nn \l__hdrs_lines_clist
      {
        \int_step_inline:nnn { \l__hdrs_c_int } { \l__hdrs_cc_int }
          {
            \__hdrs_add:nnnNn { #1 } { ##1 } { ####1 }
              \l__hdrs_colh_clist { Column }
          }
      }
    \clist_concat:NNN
      \l__hdrs_rowh_clist \l__hdrs_rowh_clist \l__hdrs_colh_clist
    \clist_remove_duplicates:N \l__hdrs_rowh_clist
    \clist_if_empty:NF \l__hdrs_rowh_clist
      {
        \tl_put_right:Nn \l__hdrs_dict_tl { ~/Headers~[ }
        \clist_map_inline:Nn \l__hdrs_rowh_clist
          {
            \tl_put_right:Ne \l__hdrs_dict_tl
              { \__tag_struct_get_id:n { ##1 } ~ }
          }
        \tl_put_right:Nn \l__hdrs_dict_tl { ] }
      }
    \tl_if_empty:NF \l__hdrs_dict_tl
      {
        \tag_struct_gput:nne { #1 } { attribute }
          { /O~/Table \l__hdrs_dict_tl }
      }
  }

% The finalize plug is the last point where the row and cell numbers exist:
% its original body sets the header rows and then restores the enclosing
% table's data. So copy them first, run it, then work on the copies; a table
% nested in a cell has finished before its outer table starts here.
\cs_new_protected:Npn \__hdrs_save:
  {
    \seq_set_eq:NN  \l__hdrs_cells_seq \g__tbl_struct_cells_seq
    \prop_set_eq:NN \l__hdrs_untagged_prop \g__tbl_untagged_cells_prop
    \int_set:Nn \l__hdrs_rows_int { \seq_count:N \l__hdrs_cells_seq }
    \int_set:Nn \l__hdrs_cols_int { \g__tbl_table_cols_tl }
    \tl_set_eq:NN \l__hdrs_table_tl \g__tbl_struct_table_tl
  }
% Layout tables (table/tagging=presentation or =div) have LaTeX's
% ARIA-role-presentation class and no header cells, so they get nothing;
% =false never gets here. Meets: WAI-ARIA 1.1 role=presentation.
\cs_new_protected:Npn \__hdrs_apply:
  {
    \str_clear:N \l__hdrs_class_str
    \tag_if_struct_exist:nT { \l__hdrs_table_tl }
      {
        \tl_clear:N \l__hdrs_tmp_tl
        \tag_get:nnN { \l__hdrs_table_tl } { struct_C } \l__hdrs_tmp_tl
        \str_set:NV \l__hdrs_class_str \l__hdrs_tmp_tl
      }
    \str_if_in:NnF \l__hdrs_class_str { /ARIA-role-presentation }
      {
        \prop_clear:N \l__hdrs_grid_prop
        \prop_clear:N \l__hdrs_minr_prop
        \prop_clear:N \l__hdrs_maxr_prop
        \prop_clear:N \l__hdrs_minc_prop
        \prop_clear:N \l__hdrs_maxc_prop
        \prop_clear:N \l__hdrs_scope_prop
        \prop_clear:N \l__hdrs_hrow_prop
        \prop_clear:N \l__hdrs_hcol_prop
        \prop_clear:N \l__hdrs_fullrow_prop
        \prop_clear:N \l__hdrs_fullcol_prop
        \seq_clear:N  \l__hdrs_order_seq
        \int_step_inline:nn { \l__hdrs_rows_int }
          {
            \clist_set:Ne \l__hdrs_row_clist
              { \seq_item:Nn \l__hdrs_cells_seq { ##1 } }
            \int_zero:N \l__hdrs_idx_int
            \int_step_inline:nn { \l__hdrs_cols_int }
              { \__hdrs_slot:nn { ##1 } { ####1 } }
          }
        \seq_map_inline:Nn \l__hdrs_order_seq
          { \tag_if_struct_exist:nT { ##1 } { \__hdrs_read_cell:n { ##1 } } }
        \__hdrs_block:NNN
          \l__hdrs_hrow_prop \l__hdrs_fullrow_prop \l__hdrs_top_int
        \__hdrs_block:NNN
          \l__hdrs_hcol_prop \l__hdrs_fullcol_prop \l__hdrs_left_int
        \seq_map_inline:Nn \l__hdrs_order_seq
          { \tag_if_struct_exist:nT { ##1 } { \__hdrs_do_cell:n { ##1 } } }
      }
  }

% Reads latex-lab-table internals (\g__tbl_struct_cells_seq,
% \g__tbl_untagged_cells_prop, \g__tbl_table_cols_tl, \g__tbl_struct_table_tl,
% the Table plug's csname) and tagpdf's \__tag_struct_get_id:n and struct_C
% code. longtable is not covered: it has its own finalize plug. If one is
% missing the build warns and writes nothing. The plug keeps its name, Table.
% REMOVE WHEN: latex-lab-table writes Headers (the TODO in its docs,
% tagging-project Discussion 930) and PAC and Acrobat read classes.
\bool_lazy_all:nTF
  {
    { \seq_if_exist_p:N \g__tbl_struct_cells_seq }
    { \prop_if_exist_p:N \g__tbl_untagged_cells_prop }
    { \tl_if_exist_p:N \g__tbl_table_cols_tl }
    { \tl_if_exist_p:N \g__tbl_struct_table_tl }
    { \cs_if_exist_p:N \__tag_struct_get_id:n }
    { \cs_if_exist_p:c { __tag_get_data_struct_C:nN } }
    { \cs_if_exist_p:c { __socket_tagsupport/tbl/finalize_plug_Table:w } }
  }
  {
    \cs_new_eq:Nc \__hdrs_orig_finalize:
      { __socket_tagsupport/tbl/finalize_plug_Table:w }
    \socket_set_plug:nnn { tagsupport/tbl/finalize } { Table }
      { \__hdrs_save: \__hdrs_orig_finalize: \__hdrs_apply: }
  }
  {
    \PackageWarningNoLine { clemson }
      {
        latex-lab-table~internals~not~found:~no~/Headers~and~no~direct
        \MessageBreak cell~attributes~are~written.~Check~the~cell~properties
        \MessageBreak in~Acrobat's~Table~Editor~before~you~share~the~PDF
      }
  }
