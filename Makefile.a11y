# Makefile.a11y -- build and check an accessible PDF.   make -f Makefile.a11y [target]
# Targets: all (default), build, requirements, check, open, clean, cleanall, example.
# TARGET=main is your document (main.tex -> main.pdf). The worked example is
# example.tex: `make -f Makefile.a11y example` builds and checks it, and
# `make -f Makefile.a11y TARGET=example open` (or any target) works on it too.
TARGET  ?= main
LATEXMK  = latexmk -lualatex -interaction=nonstopmode -halt-on-error

all: build

# build: latexmk runs every time and decides for itself. Its own record
# (.fdb_latexmk) tells it when nothing changed, and then it returns at once;
# make alone would trust a stale log next to a pdf that an editor pass left.
build:
	$(LATEXMK) $(TARGET).tex

# requirements: LuaLaTeX, latexmk and a LaTeX format of 2026-06-01 or newer.
requirements:
	@command -v lualatex >/dev/null || { echo "FAIL: lualatex not found. Install TeX Live 2026 (MacTeX 2026)."; exit 1; }
	@command -v latexmk  >/dev/null || { echo "FAIL: latexmk not found."; exit 1; }
	@printf '\\documentclass{article}\\begin{document}\\IfFormatAtLeastTF{2026-06-01}{\\typeout{FORMATOK}}{\\typeout{FORMATOLD}}x\\end{document}' > a11y-fmt-check.tex
	@lualatex -interaction=batchmode a11y-fmt-check.tex >/dev/null 2>&1; rm -f a11y-fmt-check.tex a11y-fmt-check.aux a11y-fmt-check.pdf
	@grep -q FORMATOK a11y-fmt-check.log && echo "OK: LaTeX 2026-06-01 or newer" || { echo "FAIL: LaTeX too old. Run 'sudo tlmgr update --self --all' or install TeX Live 2026."; exit 1; }
	@rm -f a11y-fmt-check.log

# check: errors, alt text and tagging warnings from the log, the package status
#        report, veraPDF (PDF/UA-2) if installed, then the Acrobat step.
check: build
	@if grep -q '^!' $(TARGET).log; then echo "FAIL: LaTeX errors in $(TARGET).log"; exit 1; fi
	@if grep -q 'Alternative text for graphic is missing' $(TARGET).log; then echo "FAIL: a picture has no alt text (see $(TARGET).log)"; exit 1; else echo "OK: every picture has alt text"; fi
	@if grep -qE 'Package tag(pdf)? Warning|latex-lab[^:]*Warning|(Package|Class) clemsona11y Warning' $(TARGET).log; then echo "FAIL: tagging or clemsona11y warnings in $(TARGET).log:"; grep -hE 'Package tag(pdf)? Warning|latex-lab[^:]*Warning|(Package|Class) clemsona11y Warning' $(TARGET).log | sort -u; exit 1; else echo "OK: no tagging warning"; fi
	@echo "-- package status (sections 1-3 of the report in $(TARGET).log; float.sty here is a known false alarm) --"
	@sed -n '/Status report of the tagging support/,$$p' $(TARGET).log | sed -n '/1\. Unsupported/,/4\. Compatible/p' | grep -v '^ *$$' | grep -v '4\. Compatible' || true
	@if command -v verapdf >/dev/null; then \
	    out=`verapdf --flavour ua2 --format text $(TARGET).pdf 2>/dev/null | tail -1`; \
	    case "$$out" in PASS*) echo "OK: veraPDF ua2 PASS";; *) echo "FAIL: veraPDF ua2: $$out"; exit 1;; esac; \
	  else echo "veraPDF not found on PATH: install it from https://verapdf.org/software/ and add its folder to PATH (PDF/UA-2 check skipped)"; fi
	@echo "Last step: Acrobat > All tools > Prepare for accessibility > Check for accessibility"
	@echo "  https://www.clemson.edu/accessibility/digital/guides/pdf/check-accessibility/"

open: build
	@open $(TARGET).pdf 2>/dev/null || xdg-open $(TARGET).pdf

# example: the worked example, built and checked exactly like your document.
example:
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) TARGET=example check

clean:
	@latexmk -c $(TARGET).tex >/dev/null 2>&1 || true
	@rm -f $(TARGET)-luamml-mathml.html $(TARGET).bbl $(TARGET).run.xml $(TARGET).xmpi

cleanall: clean
	@rm -f $(TARGET).pdf

.PHONY: all build requirements check open clean cleanall example
