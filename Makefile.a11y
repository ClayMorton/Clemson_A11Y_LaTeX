# Makefile.a11y: build and check an accessible PDF made with clemson.sty.
# Usage: make -f Makefile.a11y [target] [TARGET=name]
# TARGET is the file name without .tex (default main). Targets: build (the
# default), check, example (build and check example.tex), clean, cleanall, help.
# Without make: latexmk -lualatex name.tex, then verapdf --flavour ua2 name.pdf.
TARGET  ?= main
MK       = $(firstword $(MAKEFILE_LIST))
LATEXMK  = latexmk -lualatex -interaction=nonstopmode -halt-on-error

build:
	$(LATEXMK) $(TARGET).tex

help:
	@echo "make -f $(MK) [target] [TARGET=name]   (now: $(TARGET).tex)"
	@echo "  build     latexmk with LuaLaTeX; repeats runs until references resolve"
	@echo "  check     build quietly, read the log, run veraPDF, list what to check by hand"
	@echo "  example   build and check example.tex"
	@echo "  clean     remove build files, keep the PDF;  cleanall: remove the PDF too"

# check: what a script can verify comes from the log LaTeX writes (errors,
# pictures without alt text, formulas without MathML, tagging warnings, the
# package report of check-tagging-status) and from veraPDF's PDF/UA-2 test.
# Everything else is on the by-hand list at the end.
check:
	@fail=0; warn=0; skip=0; log=$(TARGET).log; \
	$(LATEXMK) -silent $(TARGET).tex >/dev/null 2>&1 || true; \
	echo "==================== clemson check: $(TARGET).pdf ===================="; \
	if [ ! -s "$$log" ]; then echo "FAIL  no $$log: the build did not run here"; exit 1; fi; \
	if grep -q '^!' $$log; then echo "FAIL  build: LaTeX error (first one below; see $$log)"; \
	  grep -m1 -A3 '^!' $$log | sed 's/^/      /'; echo "RESULT: FAIL"; exit 1; \
	else echo "OK    build: no LaTeX errors"; fi; \
	if grep -q 'undefined references\|Citation .* undefined\|Reference .* undefined' $$log; then \
	  echo "WARN  references: something prints as ?? (a label, ref or cite key)"; warn=1; fi; \
	n=`grep -c 'Alternative text for graphic is missing' $$log`; \
	if [ "$$n" -gt 0 ]; then echo "FAIL  pictures: $$n \\includegraphics without alt={...} or artifact (see $$log)"; fail=1; \
	else echo "OK    pictures: every \\includegraphics has alt text (tikz drawings are not counted)"; fi; \
	mfound=`sed -n 's/^==> \([0-9]*\) math fragments found.*/\1/p' $$log | tail -1`; \
	matt=`sed -n 's/^==> \([0-9]*\) MathML AF attached.*/\1/p' $$log | tail -1`; \
	mmiss=`grep -c 'mathml missing for hash' $$log`; \
	if [ "$$mmiss" -gt 0 ]; then echo "FAIL  formulas: $$mmiss without MathML (run the build again; if it stays, see README, Formulas)"; fail=1; \
	elif [ -z "$$mfound" ] || [ "$$mfound" = 0 ]; then echo "OK    formulas: none"; \
	elif [ -n "$$matt" ] && [ "$$matt" != "$$mfound" ]; then echo "WARN  formulas: $$matt of $$mfound have MathML attached"; warn=1; \
	else echo "OK    formulas: $$mfound, all with MathML"; fi; \
	tw=`awk '/Package tag(pdf)? Warning|latex-lab[^:]*Warning|Package clemson Warning/{p=!/Alternative text for graphic/} p && /^(Package|\(|latex-lab)/{print; next} {p=0}' $$log | uniq`; \
	if [ -n "$$tw" ]; then echo "FAIL  tags: LaTeX's tagging warned:"; echo "$$tw" | sed 's/^/      /'; fail=1; \
	else echo "OK    tags: no warning from LaTeX's tagging or clemson"; fi; \
	if ! grep -q 'Status report of the tagging support' $$log; then \
	  echo "SKIP  packages: no report; keep check-tagging-status in \\DocumentMetadata"; skip=1; \
	else bad=`sed -n '/Status report of the tagging support/,$$p' $$log | sed -n '/1\. Unsupported/,/3\. Partially/p' | grep -E '\.(sty|cls)$$' | grep -v 'float\.sty' | tr -d ' ' | tr '\n' ' '`; \
	  if [ -n "$$bad" ]; then echo "WARN  packages: listed as not tagging yet: $$bad(README, Packages)"; warn=1; \
	  else echo "OK    packages: none listed as unsupported or incompatible"; fi; fi; \
	if command -v verapdf >/dev/null; then out=`verapdf --flavour ua2 --format text --verbose $(TARGET).pdf 2>/dev/null`; \
	  case "`echo \"$$out\" | grep -m1 '^PASS\|^FAIL'`" in \
	    PASS*) echo "OK    PDF/UA-2: veraPDF PASS";; \
	    FAIL*) echo "FAIL  PDF/UA-2: veraPDF failed these rules (verapdf --flavour ua2 --format html $(TARGET).pdf > report.html for details):"; \
	           echo "$$out" | grep -E '^  +FAIL' | sed 's/^ */      - /'; fail=1;; \
	    *) echo "SKIP  PDF/UA-2: veraPDF did not run (needs Java and a version with --flavour ua2)"; skip=1;; \
	  esac; \
	else echo "SKIP  PDF/UA-2: veraPDF is not on PATH (https://verapdf.org/software/, needs Java)"; skip=1; fi; \
	echo "-------------------- check by hand ----------------------------------"; \
	echo " 1. Alt text: does each one say what the picture shows and why it is here?"; \
	echo "    (grep -n 'alt=' $(TARGET).tex lists them; tikz drawings need alt= too)"; \
	echo " 2. Tags and reading order: Acrobat Pro, Accessibility tags panel, then Fix"; \
	echo "    reading order; the title is a Title element and sections start at H1."; \
	echo " 3. Tables: every data table declared its header rows or columns."; \
	echo " 4. Links: the link text names the destination; Tab through them."; \
	echo " 5. Color: nothing said by color alone; 4.5:1 text, 3:1 graphics."; \
	echo "    README.md, Checking, says what Acrobat's PDF/UA-1 checker reports anyway."; \
	echo "====================================================================="; \
	if [ $$fail -ne 0 ]; then echo "RESULT: FAIL. Fix the FAIL lines and check again."; exit 1; \
	elif [ $$warn -ne 0 ]; then echo "RESULT: automatic checks passed with warnings; read the WARN lines."; \
	elif [ $$skip -ne 0 ]; then echo "RESULT: automatic checks passed; a step was skipped (SKIP)."; \
	else echo "RESULT: automatic checks passed. The five checks by hand are yours."; fi

example:
	@$(MAKE) --no-print-directory -f $(MK) TARGET=example check

clean:
	@latexmk -c $(TARGET).tex >/dev/null 2>&1 || true
	@rm -f $(TARGET)-luamml-mathml.html $(TARGET).bbl $(TARGET).run.xml $(TARGET).xmpi \
	       $(TARGET).ent $(TARGET).synctex.gz "$(TARGET).synctex(busy)"

cleanall: clean
	@rm -f $(TARGET).pdf

.PHONY: build help check example clean cleanall
